# PREP39083 operator-owned configuration.
# Copy once to .env.prep, chmod 0600, and retain it across git pulls.
# Local database/Neo4j/MCP secrets, fixed ports, image identity, Workspace and
# service Subjects are generated or derived in ignored .env.prep.runtime.

# Public origin and optional build/toolchain proxy. HTTP_PROXY/HTTPS_PROXY are used by uv,
# Docker build and npm only; they are not implicitly injected into Product provider runtime.
POC_PUBLIC_ORIGIN=CHANGE_ME_HTTPS_PREP39083_ORIGIN
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Canonical DataHub provider.
DATAHUB_GMS_URL=CHANGE_ME_HTTPS_DATAHUB_GMS
DATAHUB_GMS_TOKEN=CHANGE_ME_PREP_DATAHUB_TOKEN
DATAHUB_UI_URL=CHANGE_ME_HTTPS_DATAHUB_UI

# OpenAI-compatible Chat provider.
LLM_CHAT_URL=CHANGE_ME_HTTPS_OPENAI_COMPATIBLE_CHAT
LLM_CHAT_MODEL=CHANGE_ME_CHAT_MODEL
LLM_CHAT_TOKEN=CHANGE_ME_PREP_CHAT_TOKEN

# OpenAI-compatible embedding provider.
LLM_EMBEDDING_URL=CHANGE_ME_HTTPS_OPENAI_COMPATIBLE_EMBEDDING
LLM_EMBEDDING_MODEL=CHANGE_ME_EMBEDDING_MODEL
LLM_EMBEDDING_TOKEN=CHANGE_ME_PREP_EMBEDDING_TOKEN

# OpenAI-compatible reranker provider.
LLM_RERANKER_URL=CHANGE_ME_HTTPS_OPENAI_COMPATIBLE_RERANKER
LLM_RERANKER_MODEL=CHANGE_ME_RERANKER_MODEL
LLM_RERANKER_TOKEN=CHANGE_ME_PREP_RERANKER_TOKEN

# Optional Product runtime provider network. Blank means direct provider connections.
# POC_RUNTIME_NO_PROXY accepts exact hosts/IPs, .domain suffixes, and optional ports.
# RUNTIME_CA_CERT_FILE is one target-local absolute CA bundle path; no target CA is tracked.
POC_RUNTIME_HTTP_PROXY=
POC_RUNTIME_HTTPS_PROXY=
POC_RUNTIME_NO_PROXY=
RUNTIME_CA_CERT_FILE=

# Optional managed K9 refresh. This environment-local authority is never fabricated.
# Blank = core boot succeeds and DAILY K9 refresh is DEFERRED.
# Configured approved read-only URL = K9 scheduler is derived as enabled.
POC_K9_STUDIO_DATABASE_URL=
