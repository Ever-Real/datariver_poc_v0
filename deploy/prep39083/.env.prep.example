# PREP39083 operator template. Copy to deploy/prep39083/.env.prep, chmod 0600,
# and replace every CHANGE_ME value on the PREP host. Never commit the copy.
COMPOSE_PROJECT_NAME=datariver-prep39083
POC_BIND_HOST=127.0.0.1
POC_PORT=39083
POC_SERVER_HOST=0.0.0.0
POC_PUBLIC_ORIGIN=http://127.0.0.1:39083
POC_PLATFORM=linux/amd64
POC_IMAGE_TAG=CHANGE_ME_40_CHAR_PRODUCT_SHA
POC_SOURCE_COMMIT=CHANGE_ME_40_CHAR_PRODUCT_SHA
POC_NODE_IMAGE=node:22.19.0-bookworm-slim
POC_DOCKERFILE=deploy/poc/Dockerfile.example
POC_SHARED_NETWORK=datariver-prep39083-services

# Side-by-side isolation from the existing 39080 project. These are diagnostic
# host ports only; the application talks to the Compose service names.
POC_STATE_BIND_HOST=127.0.0.1
POC_POSTGRES_HOST_PORT=25432
POC_REDIS_PORT=26379
POC_NEO4J_HTTP_PORT=27475
POC_PGVECTOR_IMAGE=pgvector/pgvector:0.8.2-pg17-bookworm
POC_REDIS_IMAGE=redis:8.2.6-bookworm
NEO4J_IMAGE=neo4j:2026.06.0
POC_POSTGRES_DB=datariver_poc
POC_POSTGRES_USER=datariver_poc
POC_POSTGRES_PASSWORD=CHANGE_ME_PREP_POSTGRES_PASSWORD
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_PREP_NEO4J_PASSWORD

# The accepted Node POC authentication plane is LOCAL_OPAQUE_SESSION. It does
# not consume OIDC settings. Do not invent OIDC variables here; use the full
# platform deployment profile when external OIDC is a mandatory target policy.
POC_AUTH_SESSION_TTL_SECONDS=28800
POC_AUTH_FAILED_ATTEMPT_LIMIT=5
POC_AUTH_LOCK_SECONDS=900

# External DataHub. PREP/OPS must never use the DEV no-token exception.
POC_DATAHUB_ALLOW_NO_TOKEN=false
DATAHUB_GMS_URL=CHANGE_ME_HTTPS_DATAHUB_GMS
DATAHUB_GMS_TOKEN=CHANGE_ME_PREP_DATAHUB_TOKEN
DATAHUB_UI_URL=CHANGE_ME_HTTPS_DATAHUB_UI

# External Airflow and MinIO. They are not Compose services in this handoff.
AIRFLOW_URL=CHANGE_ME_HTTPS_AIRFLOW
AIRFLOW_USERNAME=CHANGE_ME_PREP_AIRFLOW_USER
AIRFLOW_PASSWORD=CHANGE_ME_PREP_AIRFLOW_PASSWORD
AIRFLOW_DAG_ID=datariver_bulk_registration_prepare
POC_AIRFLOW_SERVICE_TOKEN=CHANGE_ME_PREP_AIRFLOW_SERVICE_TOKEN
AIRFLOW_WORKSPACE_ID=CHANGE_ME_WORKSPACE_UUID
EXTERNAL_SERVICE_NO_PROXY=
MINIO_URL=CHANGE_ME_HTTPS_MINIO
MINIO_ACCESS_KEY=CHANGE_ME_PREP_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_PREP_MINIO_SECRET_KEY
MINIO_REGION=us-east-1
S3_BUCKET_QUARANTINE=datariver-quarantine
S3_BUCKET_ACCEPTED=datariver-accepted
S3_BUCKET_EXPORTS=datariver-exports
S3_BUCKET_FILEFOLDER=datariver-filefolder
S3_BUCKET_INFOSCHEMA=datariver-infoschema

# External OpenAI-compatible providers. No DEV host alias or local-model
# dependency belongs in PREP or OPS.
LLM_CHAT_URL=CHANGE_ME_HTTPS_OPENAI_COMPATIBLE_CHAT
LLM_CHAT_MODEL=CHANGE_ME_CHAT_MODEL
LLM_CHAT_TOKEN=CHANGE_ME_PREP_CHAT_TOKEN
POC_LLM_TIMEOUT_MS=15000
LLM_EMBEDDING_URL=CHANGE_ME_HTTPS_OPENAI_COMPATIBLE_EMBEDDING
LLM_EMBEDDING_MODEL=CHANGE_ME_EMBEDDING_MODEL
LLM_EMBEDDING_TOKEN=CHANGE_ME_PREP_EMBEDDING_TOKEN
LLM_RERANKER_URL=CHANGE_ME_HTTPS_OPENAI_COMPATIBLE_RERANKER
LLM_RERANKER_MODEL=CHANGE_ME_RERANKER_MODEL
LLM_RERANKER_TOKEN=CHANGE_ME_PREP_RERANKER_TOKEN

# KG2 DAILY shared-snapshot scheduler. Exact semantic generation ownership,
# heartbeat, ownership-loss abort, wait and reuse are durable DB contracts and
# require every process to share this Compose PostgreSQL state.
POC_K9_SCHEDULER_ENABLED=true
POC_K9_REFRESH_MODE=DAILY
POC_K9_SCHEDULER_TIME_ZONE=Asia/Seoul
POC_K9_SCHEDULE_HOUR=2
POC_K9_SCHEDULE_MINUTE=0
POC_K9_CLASSIFICATION_CEILING=INTERNAL
POC_K9_SYSTEM_SUBJECT_ID=CHANGE_ME_PREP_K9_SYSTEM_SUBJECT
POC_K9_WORKSPACE_ID=CHANGE_ME_WORKSPACE_UUID
POC_K9_STUDIO_DATABASE_URL=CHANGE_ME_READ_ONLY_STUDIO_DATABASE_URL
POC_KNOWLEDGE_SOURCE_MANIFEST=

# K8 MCP uses a dedicated non-human subject and credential.
POC_MCP_SERVICE_TOKEN=CHANGE_ME_PREP_MCP_SERVICE_TOKEN
POC_MCP_SUBJECT_ID=CHANGE_ME_PREP_MCP_SUBJECT
POC_MCP_WORKSPACE_ID=CHANGE_ME_WORKSPACE_UUID

# Change-history capture remains disabled until PREP discovers and accepts the
# environment-specific Kafka/Registry identity described by its canonical runbook.
POC_CHANGE_HISTORY_SCHEDULER_ENABLED=false
POC_CHANGE_HISTORY_SCHEDULER_TIME_ZONE=Asia/Seoul
POC_CHANGE_HISTORY_SCHEDULER_LOCK_NAME=datariver:prep39083:change-history-scheduler:v1
POC_MCL_KAFKA_BROKERS=
POC_MCL_KAFKA_CLIENT_ID=datariver-prep39083-mcl-v1
POC_MCL_KAFKA_GROUP_ID=datariver-prep39083-mcl-capture-v1
POC_MCL_KAFKA_TOPIC=
POC_MCL_SOURCE_IDENTITY_HASH=
POC_MCL_SCHEMA_CONTRACT_HASH=
POC_MCL_PROVIDER_NAME=DataHub
POC_MCL_PROVIDER_VERSION=
POC_MCL_KAFKA_SSL=false
POC_MCL_KAFKA_SASL_MECHANISM=
POC_MCL_KAFKA_SASL_USERNAME=
POC_MCL_KAFKA_SASL_PASSWORD=
POC_MCL_SCHEMA_REGISTRY_URL=
POC_MCL_SCHEMA_REGISTRY_USERNAME=
POC_MCL_SCHEMA_REGISTRY_PASSWORD=
POC_MCL_MAX_MESSAGES=10000
POC_MCL_MAX_RECORD_BYTES=1048576
POC_MCL_TIMEOUT_MS=300000

# Optional monitoring presentation.
UI_GRAFANA_URL=
GRAFANA_EMBED_BASE_URL=
GRAFANA_EMBED_ENABLED=false
GRAFANA_EMBED_EVIDENCE_REFERENCE=
MONITORING_DASHBOARDS_JSON=[]
