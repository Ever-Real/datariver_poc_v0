# DataRiver source-free air-gapped amd64 Pilot
#
# Copy to /home/datariver/.env. This file contains non-secret values and secret
# references only. Literal credentials belong in /home/datariver/secrets/.
#
# Loopback is the safe first-run default. Browser access from another PC requires
# reviewed HTTPS ingress and matching public origins; private-IP HTTP is not a
# secure context and is not an accepted login profile.
APP_ENV=development
DEPLOYMENT_TIER=SINGLE_NODE_PILOT
DATARIVER_ENV_FILE=/home/datariver/.env
DATARIVER_OPERATOR_PROFILE=source-free-pilot
APP_NAME=DataRiver Pilot
APP_LOG_LEVEL=INFO
APP_PUBLIC_ORIGIN=http://localhost:38102
APP_CORS_ORIGINS=http://localhost:38102
# Replace/add the exact public Web hostname or IP when APP_PUBLIC_ORIGIN changes.
APP_TRUSTED_HOSTS=localhost,127.0.0.1,api
PILOT_BIND_ADDRESS=127.0.0.1
PILOT_WEB_PORT=38102
PILOT_OIDC_PORT=18081
# Optional Compose profiles: knowledge-source,catalog-export,retention-archive
COMPOSE_PROFILES=

POSTGRES_DB=datariver
POSTGRES_USER=datariver_owner
DATABASE_URL=postgresql+asyncpg://datariver_app@postgres:5432/datariver
DATABASE_SECRET_REF=file:/run/secrets/postgres_app_password
MIGRATION_DATABASE_URL=postgresql+asyncpg://datariver_owner@postgres:5432/datariver
MIGRATION_DATABASE_SECRET_REF=file:/run/secrets/postgres_password
RELAY_DATABASE_URL=postgresql+asyncpg://datariver_relay@postgres:5432/datariver
RELAY_DATABASE_SECRET_REF=file:/run/secrets/postgres_relay_password
UPLOAD_DATABASE_URL=postgresql+asyncpg://datariver_upload@postgres:5432/datariver
UPLOAD_DATABASE_SECRET_REF=file:/run/secrets/postgres_upload_password
GOVERNANCE_DATABASE_URL=postgresql+asyncpg://datariver_governance@postgres:5432/datariver
GOVERNANCE_DATABASE_SECRET_REF=file:/run/secrets/postgres_governance_password
KNOWLEDGE_DATABASE_URL=postgresql+asyncpg://datariver_knowledge@postgres:5432/datariver
KNOWLEDGE_DATABASE_SECRET_REF=file:/run/secrets/postgres_knowledge_password
EXPORT_DATABASE_URL=postgresql+asyncpg://datariver_export@postgres:5432/datariver
EXPORT_DATABASE_SECRET_REF=file:/run/secrets/postgres_export_password
RETENTION_SCHEDULER_DATABASE_URL=postgresql+asyncpg://datariver_retention_scheduler@postgres:5432/datariver
RETENTION_SCHEDULER_DATABASE_SECRET_REF=file:/run/secrets/postgres_retention_scheduler_password
ARCHIVE_DATABASE_URL=postgresql+asyncpg://datariver_archive@postgres:5432/datariver
ARCHIVE_DATABASE_SECRET_REF=file:/run/secrets/postgres_archive_password
BOOTSTRAP_DATABASE_URL=postgresql+asyncpg://datariver_bootstrap@postgres:5432/datariver
BOOTSTRAP_DATABASE_SECRET_REF=file:/run/secrets/postgres_bootstrap_password
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_READINESS_TIMEOUT_SECONDS=1.5
WORKER_DATABASE_POOL_SIZE=5
WORKER_DATABASE_POOL_MAX_OVERFLOW=5
WORKER_DATABASE_POOL_TIMEOUT_SECONDS=10

OIDC_ISSUER=http://localhost:18081/realms/datariver
OIDC_AUDIENCE=datariver-api
OIDC_JWKS_URL=http://keycloak:8080/realms/datariver/protocol/openid-connect/certs
OIDC_PUBLIC_AUTHORITY=http://localhost:18081/realms/datariver
OIDC_PUBLIC_ORIGIN=http://localhost:18081
OIDC_CLIENT_ID=datariver-web
OIDC_HARDWARE_ACR_VALUES=2
OIDC_STEP_UP_ACR=2
OIDC_HARDWARE_AMR_VALUES=webauthn,hwk
OIDC_HARDWARE_WEBAUTHN_ENABLED=false
OIDC_PASSWORD_REAUTH_ACR_VALUES=1
OIDC_PASSWORD_REAUTH_REQUEST_ACR=1
OIDC_PASSWORD_AMR_VALUES=pwd
WORKSPACE_SELECTION_ENABLED=false
IDENTITY_ADMIN_ENABLED=true
IDENTITY_ADMIN_BASE_URL=http://keycloak:8080
IDENTITY_ADMIN_REALM=datariver
IDENTITY_ADMIN_CLIENT_ID=datariver-identity-admin
IDENTITY_ADMIN_CLIENT_SECRET_REF=file:/run/secrets/keycloak_identity_admin_client_secret
IDENTITY_PASSWORD_CHANGE_ACTION_ENABLED=true
DEVELOPMENT_ADMIN_PASSWORD_BYPASS_ENABLED=false
ADMIN_PASSWORD_FALLBACK_ENABLED=false

REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_DELIVERY_URL=redis://redis-delivery:6379/0
REDIS_CACHE_SECRET_REF=file:/run/secrets/redis_cache_password
REDIS_DELIVERY_SECRET_REF=file:/run/secrets/redis_delivery_password
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_MAX_VALUE_BYTES=1048576
CATALOG_SEARCH_CACHE_TTL_SECONDS=30
CATALOG_SEARCH_MINIMUM_QUERY_LENGTH=2

# Independently operated server-side provider. Replace with the reviewed
# internal endpoint. The token is a secret file, never an environment value.
DATAHUB_BASE_URL=https://datahub.example.internal
DATAHUB_SECRET_REF=file:/run/secrets/datahub_token
DATAHUB_EXPECTED_VERSION=v1.6.0
DATAHUB_VERSION_ENFORCEMENT=report
DATAHUB_TIMEOUT_SECONDS=10
DATAHUB_MAX_CONCURRENCY=20
DATAHUB_QUEUE_TIMEOUT_SECONDS=2
DATAHUB_CIRCUIT_FAILURE_THRESHOLD=5
DATAHUB_CIRCUIT_OPEN_SECONDS=30
DATAHUB_STALE_TTL_SECONDS=900
DATAHUB_CATALOG_PIT_VERIFIED=false

# Fixed Admin probes may connect only to these exact runtime-resolvable hosts.
# Add each reviewed DataHub/S3/browser-facing provider hostname before testing.
SYSTEM_CONFIGURATION_PROBE_ALLOWED_HOSTS=keycloak,postgres,redis-cache,redis-delivery

# Independently operated object storage. Internal and browser-facing origins
# are distinct because presigned URLs are consumed by the user's browser.
S3_ENDPOINT_URL=https://s3-api.example.internal
S3_PUBLIC_ENDPOINT_URL=https://s3.example.internal
S3_PUBLIC_ORIGIN=https://s3.example.internal
S3_REGION=us-east-1
S3_BUCKET_QUARANTINE=datariver-quarantine
S3_BUCKET_ACCEPTED=datariver-accepted
S3_BUCKET_EXPORTS=datariver-exports
S3_BUCKET_FILEFOLDER=datariver-filefolder
S3_BUCKET_INFOSCHEMA=datariver-infoschema
S3_CORS_MANAGEMENT_MODE=bucket
S3_ACCESS_KEY_FILE=/run/secrets/s3_access_key
S3_SECRET_KEY_FILE=/run/secrets/s3_secret_key
S3_EXPORT_ACCESS_KEY_FILE=/run/secrets/s3_export_access_key
S3_EXPORT_SECRET_KEY_FILE=/run/secrets/s3_export_secret_key
S3_KNOWLEDGE_ACCESS_KEY_FILE=/run/secrets/s3_knowledge_access_key
S3_KNOWLEDGE_SECRET_KEY_FILE=/run/secrets/s3_knowledge_secret_key
S3_ARCHIVE_ACCESS_KEY_FILE=/run/secrets/s3_archive_access_key
S3_ARCHIVE_SECRET_KEY_FILE=/run/secrets/s3_archive_secret_key
PRESIGNED_URL_TTL_SECONDS=900

# External provider/browser links are opt-in. HTTPS pages must not embed HTTP
# frames or hand credentials to browser configuration.
# UI_DATAHUB_URL=https://datahub.example.internal
# UI_AIRFLOW_URL=https://airflow.example.internal
# UI_GRAFANA_URL=https://grafana.example.internal
# DATAHUB_EMBED_BASE_URL=https://datahub.example.internal
# DATAHUB_EMBED_ENABLED=false
# GRAFANA_EMBED_BASE_URL=https://grafana.example.internal
# GRAFANA_EMBED_ENABLED=false

NEO4J_PROJECTION_ENABLED=false
NEO4J_SOURCE_HOST_ENABLED=false
NEO4J_ALLOWED_HOSTS=
KNOWLEDGE_PIPELINE_ENABLED=false
KNOWLEDGE_SOURCE_WORKER_ENABLED=false
CATALOG_EXPORT_WORKER_ENABLED=false
RETENTION_ARCHIVE_EXECUTION_ENABLED=false
RETENTION_WORKSPACE_IDS=
RETENTION_EXECUTION_CONTROL_FILE=/run/datariver/retention-execution.enabled
SYSTEM_CONFIGURATION_SECRET_ROOT=/run/secrets
SYSTEM_CONFIGURATION_RUNTIME_ACTIVATION_ENABLED=false
CHAT_EPHEMERAL_ADMIN_WITHOUT_RETENTION_ENABLED=false
LOCAL_INFERENCE_SOURCE_HOST_ENABLED=false
LOCAL_INFERENCE_ALLOWED_HOSTS=
LOCAL_OLLAMA_CHAT_ENABLED=false
LOCAL_OLLAMA_EMBEDDING_ENABLED=false
LOCAL_LLAMA_CPP_RERANKER_ENABLED=false
INTRANET_OPENAI_COMPATIBLE_ALLOWED_HOSTS=
INTRANET_OPENAI_COMPATIBLE_CHAT_ENABLED=false
# INTRANET_OPENAI_COMPATIBLE_CHAT_BASE_URL=https://llm.example.internal/v1
# INTRANET_OPENAI_COMPATIBLE_CHAT_MODEL=<approved-model-id>
# INTRANET_OPENAI_COMPATIBLE_CHAT_API_KEY_SECRET_REF=file:/run/secrets/intranet_llm_chat_api_key
INTRANET_OPENAI_COMPATIBLE_CHAT_TIMEOUT_SECONDS=60
INTRANET_OPENAI_COMPATIBLE_CHAT_CONTEXT_TOKENS=8192
INTRANET_OPENAI_COMPATIBLE_EMBEDDING_ENABLED=false
# INTRANET_OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=https://llm.example.internal/v1
# INTRANET_OPENAI_COMPATIBLE_EMBEDDING_MODEL=<approved-model-id>
# INTRANET_OPENAI_COMPATIBLE_EMBEDDING_API_KEY_SECRET_REF=file:/run/secrets/intranet_llm_embedding_api_key
INTRANET_OPENAI_COMPATIBLE_EMBEDDING_TIMEOUT_SECONDS=60
# No private-network Reranker adapter is implemented in this Pilot profile.

WORKER_POLL_SECONDS=0.5
GOVERNANCE_APPLY_LEASE_SECONDS=120
GOVERNANCE_APPLY_MAXIMUM_ATTEMPTS=8
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAXIMUM_ATTEMPTS=20
EVENT_RETENTION_DAYS=30
UPLOAD_LEASE_SECONDS=120
UPLOAD_MAXIMUM_ATTEMPTS=8
UPLOAD_VALIDATION_LEASE_SECONDS=300
UPLOAD_VALIDATION_MAXIMUM_ATTEMPTS=4
GOVERNANCE_WORKER_SUBJECT_ID=00000000-0000-4000-8000-000000000102
EXPORT_WORKER_SUBJECT_ID=00000000-0000-7000-8000-000000000002
RETENTION_WORKER_SUBJECT_ID=00000000-0000-7000-8000-000000000003
KNOWLEDGE_WORKER_SUBJECT_ID=00000000-0000-7000-8000-000000000004
SEED_PROFILE=none
AIRFLOW_WORKSPACE_ID=
