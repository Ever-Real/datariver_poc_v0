# Browser address
POC_BIND_HOST=0.0.0.0
POC_PORT=39080
POC_NODE_IMAGE=node:22.19.0-bookworm-slim
# Keep the tracked example for ordinary builds. On a Prep PC that needs a
# host-specific proxy Dockerfile, copy it to Dockerfile.local and change only
# this host-local .env value to deploy/poc/Dockerfile.local.
POC_DOCKERFILE=deploy/poc/Dockerfile.example

# Compose-owned POC state/cache. Override the image names with exact images
# already loaded on a closed-network PC. Only the password is required.
POC_PGVECTOR_IMAGE=pgvector/pgvector:0.8.2-pg17-bookworm
POC_REDIS_IMAGE=redis:8.2.6-bookworm
POC_STATE_BIND_HOST=127.0.0.1
POC_POSTGRES_HOST_PORT=15432
POC_REDIS_PORT=16379
POC_NEO4J_HTTP_PORT=17475
POC_POSTGRES_DB=datariver_poc
POC_POSTGRES_USER=datariver_poc
POC_POSTGRES_PASSWORD=replace-with-local-poc-password

# Compose defaults to linux/amd64, image tag local, and network
# datariver-poc-services. Provider credentials stay server-side in this file.

# DataHub GMS. The token may be blank only for an explicitly auth-disabled
# local GMS. DATAHUB_UI_URL is optional and only adds a browser-visible link.
DATAHUB_GMS_URL=
DATAHUB_GMS_TOKEN=
DATAHUB_UI_URL=

# Optional in-process daily change-history scheduler. It remains inert unless
# explicitly enabled and every POC_MCL_* binding below is present. One bounded
# MCL capture runs at the configured IANA-zone day boundary before the existing
# Catalog reconciliation; PostgreSQL advisory locking prevents duplicate hosts.
# Server-owned active subject for the private change-history API. Set this to an
# authorized subject ID before using private change-history endpoints; browsers
# must not supply or override it.
POC_CHANGE_HISTORY_ACTIVE_SUBJECT_ID=
POC_CHANGE_HISTORY_SCHEDULER_ENABLED=false
POC_CHANGE_HISTORY_SCHEDULER_TIME_ZONE=Asia/Seoul
# Deployment-unique, non-secret singleton namespace.
POC_CHANGE_HISTORY_SCHEDULER_LOCK_NAME=datariver:poc:change-history-scheduler:v1
POC_MCL_KAFKA_BROKERS=
POC_MCL_KAFKA_CLIENT_ID=
POC_MCL_KAFKA_GROUP_ID=
POC_MCL_KAFKA_TOPIC=
POC_MCL_SOURCE_IDENTITY_HASH=
POC_MCL_SCHEMA_CONTRACT_HASH=
POC_MCL_PROVIDER_NAME=
POC_MCL_PROVIDER_VERSION=
POC_MCL_KAFKA_SSL=false
POC_MCL_KAFKA_SASL_MECHANISM=
POC_MCL_KAFKA_SASL_USERNAME=
POC_MCL_KAFKA_SASL_PASSWORD=
POC_MCL_SCHEMA_REGISTRY_URL=
POC_MCL_SCHEMA_REGISTRY_USERNAME=
POC_MCL_SCHEMA_REGISTRY_PASSWORD=
POC_MCL_MAX_MESSAGES=10000
POC_MCL_MAX_RECORD_BYTES=1048576
POC_MCL_TIMEOUT_MS=300000

# Optional Monitoring dashboard. UI_GRAFANA_URL is the full dashboard URL;
# GRAFANA_EMBED_BASE_URL is only its scheme/host/port origin. For in-page
# display, all four values are required and both URLs must use the same exact
# origin. The dashboard must also allow iframe embedding from DataRiver.
UI_GRAFANA_URL=
GRAFANA_EMBED_BASE_URL=
GRAFANA_EMBED_ENABLED=false
# Non-secret operator reference for the reviewed Grafana embedding setup.
GRAFANA_EMBED_EVIDENCE_REFERENCE=
# Optional JSON array (maximum 8):
# [{"id":"platform","label":"Platform","url":"http://grafana:3000/d/...","height_px":900}]
# Tabs render as iframes only when their origin matches GRAFANA_EMBED_BASE_URL
# and the embedding evidence settings above are enabled.
MONITORING_DASHBOARDS_JSON=[]

# Airflow webserver origin (for example http://17.x.x.x:8888) and its POC
# service account. Do not append /api/v1 or /api/v2; the POC detects Airflow
# REST API v2 first (JWT from /auth/token) and then the Airflow 2.x v1 API
# (Basic auth).
AIRFLOW_URL=
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
# Only needed when this repository starts the separate POC Airflow Compose.
POC_AIRFLOW_IMAGE=datariver-airflow:3.3.0-python3.12
AIRFLOW_BIND_HOST=0.0.0.0
AIRFLOW_PORT=18888
AIRFLOW_DAG_ID=datariver_bulk_registration_prepare
AIRFLOW_DATARIVER_URL=http://host.docker.internal:39080

# MinIO/S3 API origin and account. Browser uploads are proxied by the POC Web,
# so a separate public MinIO origin and CORS settings are not required.
MINIO_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
S3_BUCKET_QUARANTINE=datariver-quarantine
S3_BUCKET_ACCEPTED=datariver-accepted
S3_BUCKET_EXPORTS=datariver-exports
S3_BUCKET_FILEFOLDER=datariver-filefolder
S3_BUCKET_INFOSCHEMA=datariver-infoschema

# Each stage can use a separate OpenAI-compatible gateway/token. URL may be a
# service base (including /v1) or that stage's exact endpoint such as
# /v1/chat/completions, /v1/embeddings, or /v1/rerank.
LLM_CHAT_URL=
LLM_CHAT_MODEL=
LLM_CHAT_TOKEN=
LLM_EMBEDDING_URL=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_TOKEN=
LLM_RERANKER_URL=
LLM_RERANKER_MODEL=
LLM_RERANKER_TOKEN=

# Neo4j is started with pgvector and Redis by this Compose project. Their
# diagnostic ports bind to POC_STATE_BIND_HOST (127.0.0.1 by default), never
# to the intranet interface unless an operator deliberately changes it.
NEO4J_IMAGE=neo4j:2026.06.0
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-local-poc-password
