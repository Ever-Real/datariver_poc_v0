ARG NODE_IMAGE=node:22.19.0-bookworm-slim
FROM ${NODE_IMAGE} AS build

WORKDIR /source/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --ignore-scripts
COPY frontend/ ./
RUN npm run build:poc
RUN npm prune --omit=dev

FROM ${NODE_IMAGE}

ARG POC_SOURCE_COMMIT=unrecorded
LABEL org.opencontainers.image.title="DataRiver 06111 Hybrid POC" \
      org.opencontainers.image.description="Original DataRiver Web UI with local opaque-session authentication and a server-side provider gateway" \
      org.opencontainers.image.revision="${POC_SOURCE_COMMIT}" \
      io.datariver.release-type="STATIC_POC" \
      io.datariver.source-base="06111ae9d94bb423adbd62d31cc56fc43feafd66" \
      io.datariver.authentication="LOCAL_OPAQUE_SESSION" \
      io.datariver.canonical-data="NONE" \
      io.datariver.external-integrations="OPTIONAL_LIVE_PROVIDERS"

WORKDIR /app
COPY --from=build /source/frontend/dist-poc/ ./dist-poc/
COPY --from=build /source/frontend/node_modules/ ./node_modules/
COPY frontend/package.json ./package.json
COPY frontend/poc-server.mjs ./poc-server.mjs
COPY frontend/poc-authorization.mjs ./poc-authorization.mjs
COPY frontend/poc-access-document.mjs ./poc-access-document.mjs
COPY frontend/poc-bootstrap-local-user.mjs ./poc-bootstrap-local-user.mjs
COPY frontend/poc-disable-local-credential.mjs ./poc-disable-local-credential.mjs
COPY frontend/poc-local-auth.mjs ./poc-local-auth.mjs
COPY frontend/poc-state-store.mjs ./poc-state-store.mjs
COPY frontend/poc-change-history-scheduler.mjs ./poc-change-history-scheduler.mjs
COPY frontend/poc-mcl-capture.mjs ./poc-mcl-capture.mjs
COPY frontend/poc-assets/ ./poc-assets/

ENV POC_SERVER_HOST=0.0.0.0 \
    POC_SERVER_PORT=8080

USER node
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=6 \
  CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT []
CMD ["node", "poc-server.mjs"]
