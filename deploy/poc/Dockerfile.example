ARG NODE_IMAGE=node:22.19.0-bookworm-slim
FROM ${NODE_IMAGE} AS build

WORKDIR /source/frontend
COPY frontend/package.json frontend/package-lock.json ./
# HTTP_PROXY/HTTPS_PROXY/NO_PROXY are Docker's predefined proxy build arguments.
# Deliberately do not redeclare them with ARG: Docker then excludes their values
# from image history and cache metadata. A private, step-local npmrc is removed in
# the same layer so proxy credentials and the bounded TLS relaxation cannot persist.
RUN set -eu; \
    export NPM_CONFIG_USERCONFIG=/tmp/datariver-npmrc; \
    npm_proxy="${HTTPS_PROXY:-${HTTP_PROXY:-}}"; \
    if [ -n "${npm_proxy}" ]; then \
      npm config set proxy "${npm_proxy}"; \
      npm config set https-proxy "${npm_proxy}"; \
      npm config set strict-ssl false; \
    fi; \
    npm ci --ignore-scripts; \
    if [ -n "${npm_proxy}" ]; then \
      npm config delete proxy; \
      npm config delete https-proxy; \
      npm config set strict-ssl true; \
      test "$(npm config get strict-ssl)" = true; \
    fi; \
    rm -f "${NPM_CONFIG_USERCONFIG}"
COPY frontend/ ./
RUN npm run build:poc
RUN npm prune --omit=dev

FROM ${NODE_IMAGE}

ARG POC_SOURCE_COMMIT=unrecorded
LABEL org.opencontainers.image.title="DataRiver 06111 Hybrid POC" \
      org.opencontainers.image.description="Original DataRiver Web UI with local opaque-session authentication and a server-side provider gateway" \
      org.opencontainers.image.revision="${POC_SOURCE_COMMIT}" \
      io.datariver.release-type="STATIC_POC" \
      io.datariver.source-base="06111ae9d94bb423adbd62d31cc56fc43feafd66" \
      io.datariver.authentication="LOCAL_OPAQUE_SESSION" \
      io.datariver.canonical-data="NONE" \
      io.datariver.external-integrations="OPTIONAL_LIVE_PROVIDERS"

WORKDIR /app
COPY --from=build /source/frontend/dist-poc/ ./dist-poc/
COPY --from=build /source/frontend/node_modules/ ./node_modules/
COPY frontend/package.json ./package.json
COPY frontend/poc-server.mjs ./poc-server.mjs
COPY frontend/poc-authorization.mjs ./poc-authorization.mjs
COPY frontend/poc-table-data-access.mjs ./poc-table-data-access.mjs
COPY frontend/poc-cr-lifecycle.mjs ./poc-cr-lifecycle.mjs
COPY frontend/poc-access-document.mjs ./poc-access-document.mjs
COPY frontend/poc-table-system-mappings.mjs ./poc-table-system-mappings.mjs
COPY frontend/poc-datahub-current-table.mjs ./poc-datahub-current-table.mjs
COPY frontend/poc-feature-security-policy.mjs ./poc-feature-security-policy.mjs
COPY frontend/poc-bootstrap-local-user.mjs ./poc-bootstrap-local-user.mjs
COPY frontend/poc-prep-bootstrap.mjs ./poc-prep-bootstrap.mjs
COPY frontend/poc-provider-preflight.mjs ./poc-provider-preflight.mjs
COPY frontend/poc-provider-transport.mjs ./poc-provider-transport.mjs
COPY frontend/poc-llm-timeout.mjs ./poc-llm-timeout.mjs
COPY frontend/poc-disable-local-credential.mjs ./poc-disable-local-credential.mjs
COPY frontend/poc-local-auth.mjs ./poc-local-auth.mjs
COPY frontend/poc-state-store.mjs ./poc-state-store.mjs
COPY frontend/poc-change-history-scheduler.mjs ./poc-change-history-scheduler.mjs
COPY frontend/poc-mcl-capture.mjs ./poc-mcl-capture.mjs
COPY frontend/poc-mcl-discovery.mjs ./poc-mcl-discovery.mjs
COPY frontend/poc-mcl-runtime-failure.mjs ./poc-mcl-runtime-failure.mjs
COPY frontend/poc-k9-managed-graphs.mjs ./poc-k9-managed-graphs.mjs
COPY frontend/poc-k9-scheduler.mjs ./poc-k9-scheduler.mjs
COPY frontend/poc-k9-metadata-collection.mjs ./poc-k9-metadata-collection.mjs
COPY frontend/poc-knowledge-k9-contracts.mjs ./poc-knowledge-k9-contracts.mjs
COPY frontend/poc-assets/ ./poc-assets/

ENV POC_SERVER_HOST=0.0.0.0 \
    POC_SERVER_PORT=8080

USER node
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=6 \
  CMD node -e "fetch('http://127.0.0.1:8080/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT []
CMD ["node", "poc-server.mjs"]
