{
  "name": "datariver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "cytoscape:csp": "node frontend/scripts/patch-cytoscape-csp.mjs",
    "cytoscape:csp:verify": "node frontend/scripts/patch-cytoscape-csp.mjs --verify",
    "predev": "npm run cytoscape:csp",
    "dev": "vite --config frontend/vite.config.ts",
    "prebuild": "npm run cytoscape:csp",
    "build": "tsc -b frontend && vite build --config frontend/vite.config.ts",
    "typecheck": "tsc -b frontend --pretty false",
    "lint": "eslint backend frontend scripts --max-warnings=0",
    "start": "node backend/src/bootstrap.mjs",
    "bootstrap-user": "node backend/scripts/bootstrap-local-user.mjs",
    "disable-credential": "node backend/scripts/disable-local-credential.mjs"
  },
  "dependencies": {
    "@kafkajs/confluent-schema-registry": "4.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "8.21.3",
    "@tiptap/core": "^3.30.0",
    "@tiptap/extension-table": "^3.30.0",
    "@tiptap/extension-text-align": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "@xyflow/react": "12.11.2",
    "cytoscape": "3.34.1",
    "cytoscape-cola": "2.5.1",
    "hash-wasm": "4.12.0",
    "kafkajs": "2.2.4",
    "kafkajs-snappy": "1.1.0",
    "lucide-react": "1.21.0",
    "oidc-client-ts": "3.5.0",
    "pg": "^8.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "redis": "^6.2.1",
    "tailwindcss": "4.3.3",
    "undici": "7.29.0",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
