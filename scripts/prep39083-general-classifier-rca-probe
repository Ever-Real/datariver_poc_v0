#!/usr/bin/env bash
set -euo pipefail

# DATARIVER_LEGACY_RCA_PREP39083_GENERAL_CLASSIFIER_V1
# Lifecycle: TEMPORARY_RCA
# Scope: PREP39083 GENERAL ROUTING_CLASSIFIER CONTRACT subtype capture
# SafeRemovalWhen: GENERAL classifier RCA COMPLETE and corresponding runtime evidence is checkpointed
# PersistentRuntimeMutation: NONE
# DatabaseMutation: NONE
# ProviderCallsPerRun: 3
# Neo4jMutation: NONE

readonly OUTPUT_PREFIX='GENERAL_RCA_EVIDENCE'
readonly COMPOSE_PROJECT='datariver-prep39083'
readonly COMPOSE_SERVICE='web'
readonly RELEASE_RELATIVE_PATH='deploy/prep39083/release.json'
readonly RELEASE_REF='refs/remotes/origin/prep39083-release'
readonly OCI_REVISION_LABEL='org.opencontainers.image.revision'

emit_failure() {
  printf '%s\n' "${OUTPUT_PREFIX}|subtype=PROBE_FAILED|stage=$1"
}

fail() {
  emit_failure "$1"
  exit 2
}

command -v git >/dev/null 2>&1 || fail CHECKOUT
command -v python3 >/dev/null 2>&1 || fail PRODUCT_IDENTITY
command -v docker >/dev/null 2>&1 || fail DOCKER

readonly SCRIPT_DIRECTORY="$({ CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd; })"
REPOSITORY_ROOT="$(git -C "$SCRIPT_DIRECTORY" rev-parse --show-toplevel 2>/dev/null)" \
  || fail CHECKOUT
readonly REPOSITORY_ROOT
[[ "$SCRIPT_DIRECTORY" == "$REPOSITORY_ROOT/scripts" ]] || fail CHECKOUT

web_ids=()
while IFS= read -r container_id; do
  [[ -n "$container_id" ]] && web_ids+=("$container_id")
done < <(
  docker ps \
    --filter "label=com.docker.compose.project=$COMPOSE_PROJECT" \
    --filter "label=com.docker.compose.service=$COMPOSE_SERVICE" \
    --format '{{.ID}}' 2>/dev/null
)

[[ "${#web_ids[@]}" -eq 1 ]] || fail WEB_IDENTITY
readonly WEB_CONTAINER_ID="${web_ids[0]}"

RELEASE_DOCUMENT="$(
  git -C "$REPOSITORY_ROOT" show "$RELEASE_REF:$RELEASE_RELATIVE_PATH" 2>/dev/null
)" || fail PRODUCT_IDENTITY
readonly RELEASE_DOCUMENT

EXPECTED_PRODUCT="$(python3 - "$RELEASE_DOCUMENT" <<'PY'
import json
import re
import sys

try:
    value = json.loads(sys.argv[1])
    product = value.get("product_sha") if isinstance(value, dict) else None
except json.JSONDecodeError:
    product = None

if not isinstance(product, str) or re.fullmatch(r"[0-9a-f]{40}", product) is None:
    raise SystemExit(2)
print(product)
PY
)" || fail PRODUCT_IDENTITY
readonly EXPECTED_PRODUCT

RUNNING_IMAGE_ID="$(
  docker inspect --format '{{.Image}}' "$WEB_CONTAINER_ID" 2>/dev/null
)" || fail WEB_IDENTITY
[[ -n "$RUNNING_IMAGE_ID" ]] || fail WEB_IDENTITY
readonly RUNNING_IMAGE_ID

RUNNING_PRODUCT="$(
  docker image inspect \
    --format "{{index .Config.Labels \"$OCI_REVISION_LABEL\"}}" \
    "$RUNNING_IMAGE_ID" 2>/dev/null
)" || fail PRODUCT_IDENTITY
readonly RUNNING_PRODUCT

[[ "$RUNNING_PRODUCT" =~ ^[0-9a-f]{40}$ ]] || fail PRODUCT_IDENTITY
[[ "$RUNNING_PRODUCT" == "$EXPECTED_PRODUCT" ]] || fail PRODUCT_IDENTITY

set +e
probe_output="$(
  docker exec -i "$WEB_CONTAINER_ID" node --input-type=module 2>/dev/null <<'NODE'
import { mkdtemp, readFile, readdir, rm, symlink, writeFile } from 'node:fs/promises'
import { tmpdir } from 'node:os'
import { join } from 'node:path'
import process from 'node:process'
import pg from 'pg'

const OUTPUT_PREFIX = 'GENERAL_RCA_EVIDENCE'
const QUESTION = '데이터 계보가 무엇인지 일반적으로 설명해줘.'
const PROBE_ATTEMPT_COUNT = 3
const SERVER_PATH = '/app/poc-server.mjs'
const STATE_STORE_PATH = '/app/poc-state-store.mjs'
const SERVER_FILE = 'poc-server.mjs'
const PROVIDER_TRANSPORT_NEEDLE = 'const providerTransport = createProviderTransport(process.env)'
const CHAT_ROUTE_NEEDLE = 'async function chatRoute(question, requestedMode, principal, signal) {'
const CLASSIFIER_CALL_NEEDLE = "      const classification = await llmRequest(llm.chat, '/chat/completions', {"
const CLASSIFIER_VALUE_NEEDLE = '      const value = classification.choices?.[0]?.message?.content'
const LLM_SERIALIZE_NEEDLE = '  const serializedBody = JSON.stringify(body)'
const NEO4J_QUERY_NEEDLE = 'async function neo4jQuery(statement, parameters = {}, timeoutMs = providerTimeoutMs, signal) {'
const DISCOVERY_SQL_NULL_NEEDLE = `command.discovery === null
            ? null
            : JSON.stringify(command.discovery)`
const DISCOVERY_JSON_NULL_NEEDLE = 'JSON.stringify(command.discovery),'
const DISCOVERY_SQL_NEEDLE = '$11::jsonb'
const ALLOWED_SUBTYPES = new Set([
  'PASS',
  'PROVIDER_RESPONSE_JSON_INVALID',
  'PROVIDER_RESPONSE_SHAPE_INVALID',
  'EMPTY_CLASSIFIER_RESULT',
  'CLASSIFIER_JSON_PARSE_FAILED',
  'CLASSIFIER_SEMANTIC_INVARIANT_FAILED',
  'CLASSIFIER_SCHEMA_VALIDATION_FAILED',
  'CLASSIFIER_JSON_SHAPE_INVALID',
  'UNCLASSIFIED_LOCAL_CONTRACT',
])
const SAFE_PROVIDER_CODES = new Set([
  'POC_LLM_PROVIDER_AUTH_FAILED',
  'POC_LLM_PROVIDER_CONNECTIVITY_FAILED',
  'POC_LLM_PROVIDER_CONTRACT_FAILED',
  'POC_LLM_PROVIDER_HTTP_FAILED',
  'POC_LLM_PROVIDER_TIMEOUT',
])
const SAFE_HTTP_CLASSES = new Set(['HTTP_4XX', 'HTTP_5XX', 'HTTP_OTHER'])
const { Pool } = pg

let pool
let client
let temporaryDirectory
let serverModule
let transactionStarted = false

function probeFailure(stage) {
  const error = new Error('Bounded GENERAL RCA probe failure.')
  error.probeStage = stage
  return error
}

function countOccurrences(source, needle) {
  return source.split(needle).length - 1
}

function databaseConfig() {
  const common = {
    max: 1,
    connectionTimeoutMillis: 10_000,
    options: '-c default_transaction_read_only=on -c statement_timeout=10000',
  }
  const databaseUrl = process.env.POC_DATABASE_URL?.trim()
  if (databaseUrl) return { ...common, connectionString: databaseUrl }

  const host = process.env.POC_POSTGRES_HOST?.trim()
  if (!host) throw probeFailure('DATABASE_CONFIGURATION')
  return {
    ...common,
    host,
    port: Number(process.env.POC_POSTGRES_PORT || 5432),
    database: process.env.POC_POSTGRES_DB?.trim() || 'datariver_poc',
    user: process.env.POC_POSTGRES_USER?.trim() || 'datariver_poc',
    password: process.env.POC_POSTGRES_PASSWORD || undefined,
  }
}

async function readPersistedEvidence() {
  pool = new Pool(databaseConfig())
  client = await pool.connect()
  await client.query('BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY')
  transactionStarted = true
  const readOnly = await client.query('SHOW transaction_read_only')
  if (readOnly.rows[0]?.transaction_read_only !== 'on') {
    throw probeFailure('DATABASE_READ_ONLY')
  }
  const constraintResult = await client.query(`
    SELECT pg_get_constraintdef(constraint_row.oid, true) AS definition
    FROM pg_constraint AS constraint_row
    JOIN pg_class AS table_row ON table_row.oid = constraint_row.conrelid
    JOIN pg_namespace AS namespace_row ON namespace_row.oid = table_row.relnamespace
    WHERE namespace_row.nspname = 'public'
      AND table_row.relname = 'poc_chat_messages'
      AND constraint_row.conname = 'ck_poc_chat_message_discovery'
  `)
  if (constraintResult.rows.length !== 1
    || typeof constraintResult.rows[0]?.definition !== 'string') {
    throw probeFailure('DB_CONSTRAINT')
  }
  const normalized = constraintResult.rows[0].definition.toLowerCase().replace(/\s+/gu, ' ')
  const constraint = normalized.includes('discovery_json is null')
    && normalized.includes('jsonb_typeof(discovery_json)')
    && normalized.includes("'object'")
    && normalized.includes('1048576')
    ? 'PASS'
    : 'OTHER'

  const uiRouteResult = await client.query(`
    SELECT route_json->>'requested_mode' AS requested_mode,
      route_json->>'selected_mode' AS selected_mode
    FROM poc_chat_messages
    WHERE role = 'assistant'
      AND route_json IS NOT NULL
    ORDER BY created_at DESC, ordinal DESC, message_id DESC
    LIMIT 1
  `)
  const uiRequestedMode = boundedMode(uiRouteResult.rows[0]?.requested_mode)
  const uiSelectedMode = boundedMode(uiRouteResult.rows[0]?.selected_mode)

  const managedGraphResult = await client.query(`
    SELECT
      policy.*,
      latest.run_id AS latest_run_id,
      latest.status AS latest_result,
      latest.started_at AS latest_started_at,
      latest.completed_at AS latest_completed_at,
      latest.error_message AS latest_error_message,
      latest.manifest AS latest_manifest,
      active.run_id AS active_run_id,
      active.started_at AS active_started_at,
      active.completed_at AS active_completed_at,
      active.input_snapshot_hash AS active_input_snapshot_hash,
      active.manifest AS active_manifest,
      active.canonical_release AS active_canonical_release
    FROM poc_k9_managed_graph_policies AS policy
    LEFT JOIN LATERAL (
      SELECT run_id, status, started_at, completed_at, error_message, manifest
      FROM poc_k9_refresh_runs
      WHERE graph_id = policy.graph_id
      ORDER BY started_at DESC, run_id DESC
      LIMIT 1
    ) AS latest ON TRUE
    LEFT JOIN LATERAL (
      SELECT run_id, started_at, completed_at, input_snapshot_hash, manifest, canonical_release
      FROM poc_k9_refresh_runs
      WHERE graph_id = policy.graph_id
        AND active_release_pointer = policy.active_release_pointer
        AND status IN ('RUN', 'NO_OP')
        AND canonical_release IS NOT NULL
      ORDER BY started_at DESC, run_id DESC
      LIMIT 1
    ) AS active ON policy.active_release_pointer IS NOT NULL
    ORDER BY policy.managed_intent, policy.graph_id
  `)
  const activeGenerationResult = await client.query(`
    SELECT scope, value
    FROM poc_state
    WHERE scope LIKE 'catalog-embedding-active-v1:%'
  `)
  const activeGenerations = new Map(activeGenerationResult.rows.flatMap((row) => {
    const value = row.value
    if (typeof row.scope !== 'string' || !value || typeof value !== 'object'
      || value.projection_version !== 1
      || typeof value.binding_hash !== 'string'
      || typeof value.source_generation !== 'string'
      || row.scope !== `catalog-embedding-active-v1:${value.binding_hash}`) return []
    return [[value.binding_hash, value.source_generation]]
  }))

  await client.query('ROLLBACK')
  transactionStarted = false
  client.release()
  client = undefined
  await pool.end()
  pool = undefined
  return {
    constraint,
    uiRequestedMode,
    uiSelectedMode,
    managedGraphRows: managedGraphResult.rows,
    activeGenerations,
  }
}

async function prepareTemporaryServer(source) {
  if (countOccurrences(source, PROVIDER_TRANSPORT_NEEDLE) !== 1
    || countOccurrences(source, CHAT_ROUTE_NEEDLE) !== 1
    || countOccurrences(source, CLASSIFIER_CALL_NEEDLE) !== 1
    || countOccurrences(source, CLASSIFIER_VALUE_NEEDLE) !== 1
    || countOccurrences(source, LLM_SERIALIZE_NEEDLE) !== 1
    || countOccurrences(source, NEO4J_QUERY_NEEDLE) !== 1) {
    throw probeFailure('SOURCE_CONTRACT')
  }

  temporaryDirectory = await mkdtemp(join(tmpdir(), 'datariver-general-classifier-rca-'))
  for (const entry of await readdir('/app', { withFileTypes: true })) {
    if (entry.name === SERVER_FILE) continue
    if (!(entry.name.endsWith('.mjs') || entry.name === 'node_modules')) continue
    await symlink(join('/app', entry.name), join(temporaryDirectory, entry.name), entry.isDirectory() ? 'dir' : 'file')
  }

  let instrumented = source.replace(
    PROVIDER_TRANSPORT_NEEDLE,
    `export ${PROVIDER_TRANSPORT_NEEDLE}`,
  )
  instrumented = instrumented.replace(
    CHAT_ROUTE_NEEDLE,
    `export ${CHAT_ROUTE_NEEDLE}`,
  )
  instrumented = instrumented.replace(
    NEO4J_QUERY_NEEDLE,
    `export ${NEO4J_QUERY_NEEDLE}`,
  )
  instrumented = instrumented.replace(
    LLM_SERIALIZE_NEEDLE,
    `  if (globalThis.__DATARIVER_GENERAL_CLASSIFIER_RCA?.captureRequest === true) {
    const capture = globalThis.__DATARIVER_GENERAL_CLASSIFIER_RCA
    capture.captureRequest = false
    capture.requests.push({
      maxTokens: body?.max_tokens,
      maxCompletionTokensPresent: Object.hasOwn(body || {}, 'max_completion_tokens'),
      reasoningEffort: body?.reasoning_effort,
      nestedReasoningEffort: body?.reasoning?.effort,
      temperature: body?.temperature,
      modelPresent: typeof body?.model === 'string' && Boolean(body.model),
      strictJsonSchema: body?.response_format?.type === 'json_schema'
        && body?.response_format?.json_schema?.strict === true,
    })
  }
${LLM_SERIALIZE_NEEDLE}`,
  )
  instrumented = instrumented.replace(
    CLASSIFIER_CALL_NEEDLE,
    `      globalThis.__DATARIVER_GENERAL_CLASSIFIER_RCA.providerCalls += 1
      globalThis.__DATARIVER_GENERAL_CLASSIFIER_RCA.captureRequest = true
${CLASSIFIER_CALL_NEEDLE}`,
  )
  instrumented = instrumented.replace(
    CLASSIFIER_VALUE_NEEDLE,
    `${CLASSIFIER_VALUE_NEEDLE}\n      Object.assign(globalThis.__DATARIVER_GENERAL_CLASSIFIER_RCA, { classification, rawValue: value })`,
  )
  await writeFile(join(temporaryDirectory, SERVER_FILE), instrumented, { encoding: 'utf8', mode: 0o600 })
  return import(`file://${join(temporaryDirectory, SERVER_FILE)}?rca=${Date.now()}`)
}

function boundedToken(value, fallback = 'NONE') {
  if (typeof value !== 'string') return fallback
  const token = value.trim().toUpperCase()
  return /^[A-Z0-9_]{1,64}$/u.test(token) ? token : fallback
}

function boundedMode(value) {
  return ['AUTO', 'GENERAL', 'VECTOR', 'GRAPH'].includes(value) ? value : 'U'
}

function contentType(value) {
  if (value === undefined) return 'UNDEFINED'
  if (value === null) return 'NULL'
  if (Array.isArray(value)) return 'ARRAY'
  const type = typeof value
  return ['string', 'number', 'boolean', 'object'].includes(type) ? type.toUpperCase() : 'OTHER'
}

function propertyPresence(value, properties) {
  if (!value || typeof value !== 'object') return 'U'
  return properties.some((property) => (
    Object.hasOwn(value, property)
    && value[property] !== undefined
    && value[property] !== null
    && value[property] !== false
    && value[property] !== ''
  )) ? 'Y' : 'N'
}

function causeChain(error) {
  const values = []
  const seen = new Set()
  let current = error
  while (current && typeof current === 'object' && !seen.has(current) && values.length < 8) {
    seen.add(current)
    values.push(current)
    current = current.cause
  }
  return values
}

function parsedRawValue(rawValue) {
  if (rawValue === undefined || rawValue === null
    || (typeof rawValue === 'string' && !rawValue.trim())) return { state: 'EMPTY' }
  if (typeof rawValue !== 'string') return { state: 'NON_STRING' }
  try {
    return { state: 'PARSED', value: JSON.parse(rawValue) }
  } catch {
    return { state: 'INVALID_JSON' }
  }
}

function rawClassifierShape(rawValue) {
  const parsed = parsedRawValue(rawValue)
  if (parsed.state !== 'PARSED') return parsed.state
  if (!parsed.value || typeof parsed.value !== 'object' || Array.isArray(parsed.value)) {
    return Array.isArray(parsed.value) ? 'JSON_ARRAY' : 'JSON_SCALAR'
  }
  const expectedKeys = [
    'confidence', 'entity_type_hints', 'intent', 'mode', 'primary_concepts',
    'relation_intent', 'secondary_concepts', 'selected_graph_asset',
  ]
  const keys = Object.keys(parsed.value).sort()
  return keys.length === expectedKeys.length
    && keys.every((key, index) => key === expectedKeys[index])
    ? 'JSON_OBJECT_EXACT_KEYS'
    : 'JSON_OBJECT_OTHER_KEYS'
}

function failurePoint(subtype) {
  return ({
    PASS: 'PASS',
    PROVIDER_RESPONSE_JSON_INVALID: 'PROVIDER_JSON',
    PROVIDER_RESPONSE_SHAPE_INVALID: 'PROVIDER_SHAPE',
    EMPTY_CLASSIFIER_RESULT: 'CONTENT_EXTRACTION',
    CLASSIFIER_JSON_PARSE_FAILED: 'JSON_PARSE',
    CLASSIFIER_SEMANTIC_INVARIANT_FAILED: 'SEMANTIC_VALIDATION',
    CLASSIFIER_SCHEMA_VALIDATION_FAILED: 'SCHEMA_VALIDATION',
    CLASSIFIER_JSON_SHAPE_INVALID: 'JSON_SHAPE',
    UNCLASSIFIED_LOCAL_CONTRACT: 'LOCAL_CONTRACT',
  })[subtype] || 'LOCAL_CONTRACT'
}

function requestShape(value) {
  if (!value || typeof value !== 'object') return 'U'
  const maxTokens = Number.isSafeInteger(value.maxTokens) && value.maxTokens >= 0
    ? String(value.maxTokens)
    : 'U'
  const reasoning = value.reasoningEffort === 'none' ? 'N' : boundedToken(value.reasoningEffort, 'U')
  const nestedReasoning = value.nestedReasoningEffort === 'none'
    ? 'N'
    : boundedToken(value.nestedReasoningEffort, 'U')
  const temperature = value.temperature === 0 ? '0' : 'U'
  return [
    `MT${maxTokens}`,
    `MCT${value.maxCompletionTokensPresent ? 'Y' : 'N'}`,
    `RE${reasoning}`,
    `RN${nestedReasoning}`,
    `T${temperature}`,
    `M${value.modelPresent ? 'Y' : 'N'}`,
    `JS${value.strictJsonSchema ? 'Y' : 'N'}`,
  ].join('.')
}

function classifyFailure(routeError, rawValue) {
  const chain = causeChain(routeError)
  const messages = chain.map((item) => String(item.message || ''))
  if (messages.includes('The LLM provider returned invalid JSON.')) {
    return 'PROVIDER_RESPONSE_JSON_INVALID'
  }
  if (messages.includes('The LLM provider returned an invalid response contract.')) {
    return 'PROVIDER_RESPONSE_SHAPE_INVALID'
  }
  const parsed = parsedRawValue(rawValue)
  if (messages.includes('The Chat route classifier returned no route.')) {
    return parsed.state === 'EMPTY' ? 'EMPTY_CLASSIFIER_RESULT' : 'CLASSIFIER_JSON_SHAPE_INVALID'
  }
  if (chain.some((item) => item instanceof SyntaxError) || parsed.state === 'INVALID_JSON') {
    return 'CLASSIFIER_JSON_PARSE_FAILED'
  }
  if (messages.includes('The Chat route classifier returned an inconsistent route.')) {
    return 'CLASSIFIER_SEMANTIC_INVARIANT_FAILED'
  }
  if (messages.includes('The Chat route classifier returned a malformed route.')) {
    return parsed.state === 'PARSED'
      && parsed.value && typeof parsed.value === 'object' && !Array.isArray(parsed.value)
      ? 'CLASSIFIER_SCHEMA_VALIDATION_FAILED'
      : 'CLASSIFIER_JSON_SHAPE_INVALID'
  }
  return 'UNCLASSIFIED_LOCAL_CONTRACT'
}

function classifierEvidence(route, routeError, capture, request) {
  const classification = capture.classification
  const choice = Array.isArray(classification?.choices) ? classification.choices[0] : undefined
  const message = choice?.message
  const rawValue = capture.rawValue
  const subtype = route ? 'PASS' : classifyFailure(routeError, rawValue)
  if (!ALLOWED_SUBTYPES.has(subtype)) throw probeFailure('CLASSIFICATION')
  const choices = Array.isArray(classification?.choices) && classification.choices.length <= 100
    ? String(classification.choices.length)
    : 'U'
  const codeValue = causeChain(routeError).map((item) => item.code)
    .find((value) => SAFE_PROVIDER_CODES.has(value))
  const diagnostic = causeChain(routeError).map((item) => item.diagnostic)
    .find((value) => value && typeof value === 'object')
  const http = SAFE_HTTP_CLASSES.has(diagnostic?.provider_http_class)
    ? diagnostic.provider_http_class
    : 'NONE'
  const reasoning = propertyPresence(message, ['reasoning', 'reasoning_content', 'thinking'])
  const refusal = propertyPresence(message, ['refusal'])
  return {
    subtype,
    code: codeValue || 'NONE',
    http,
    choices,
    content: contentType(rawValue),
    finish: boundedToken(choice?.finish_reason, choice?.finish_reason === null ? 'NONE' : 'U'),
    reasoning,
    refusal,
    route: boundedToken(route?.selected_mode, 'NONE'),
    shape: rawClassifierShape(rawValue),
    point: failurePoint(subtype),
    request: requestShape(request),
  }
}

function attemptToken(evidence) {
  return [
    evidence.subtype,
    evidence.code,
    evidence.http,
    evidence.choices,
    evidence.content,
    evidence.finish,
    evidence.reasoning,
    evidence.refusal,
    evidence.route,
    evidence.shape,
    evidence.point,
    evidence.request,
  ].join(',')
}

function canonicalJson(value) {
  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(',')}]`
  if (value && typeof value === 'object') {
    return `{${Object.keys(value).sort().map((key) => `${JSON.stringify(key)}:${canonicalJson(value[key])}`).join(',')}}`
  }
  return JSON.stringify(value)
}

function graphDocumentsByIdentity(documents, identityOf) {
  if (!Array.isArray(documents)) return null
  const result = new Map()
  for (const document of documents) {
    const identity = identityOf(document)
    if (!identity || result.has(identity)) return null
    result.set(identity, canonicalJson(document))
  }
  return result
}

function graphDocumentsEqual(expected, observed, identityOf) {
  if (!Array.isArray(expected) || !Array.isArray(observed) || expected.length !== observed.length) {
    return false
  }
  const expectedByIdentity = graphDocumentsByIdentity(expected, identityOf)
  const observedByIdentity = graphDocumentsByIdentity(observed, identityOf)
  if (!expectedByIdentity || !observedByIdentity || expectedByIdentity.size !== observedByIdentity.size) {
    return false
  }
  for (const [identity, expectedDocument] of expectedByIdentity) {
    if (observedByIdentity.get(identity) !== expectedDocument) return false
  }
  return true
}

function graphProperties(value) {
  if (typeof value !== 'string' || !value) return {}
  try {
    const parsed = JSON.parse(value)
    return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {}
  } catch {
    return {}
  }
}

function managedGraphKey(value) {
  if (value === 'metadata-lineage') return 'ML'
  if (value === 'data-glossary') return 'DG'
  return 'OT'
}

function graphFlag(value) {
  return value ? '1' : '0'
}

function graphEvidenceToken(key, flags, classification, cause) {
  return `${key}:R${graphFlag(flags.ready)}P${graphFlag(flags.published)}`
    + `A${graphFlag(flags.active)}S${graphFlag(flags.store)}D${graphFlag(flags.digest)}`
    + `:${classification}:${cause}`
}

async function auditManagedGraph(row) {
  const key = managedGraphKey(row.managed_intent)
  const active = typeof row.active_release_pointer === 'string' && Boolean(row.active_release_pointer)
  const published = Boolean(row.active_run_id && row.active_canonical_release)
  const flags = { ready: active && published, published, active, store: false, digest: false }
  if (!active) {
    const classification = ['RUN', 'NO_OP'].includes(row.latest_result)
      ? 'READY_BUT_UNPUBLISHED'
      : 'ACTIVE_RELEASE_MISSING'
    return graphEvidenceToken(key, flags, classification, 'POINTER')
  }
  const canonicalRelease = row.active_canonical_release
  if (!published || !canonicalRelease || typeof canonicalRelease !== 'object'
    || canonicalRelease.manifest?.graph_id !== row.graph_id
    || canonicalRelease.manifest?.policy_hash !== row.policy_hash
    || canonicalRelease.manifest?.input_snapshot_hash !== row.active_input_snapshot_hash
    || !Array.isArray(canonicalRelease.nodes)
    || !Array.isArray(canonicalRelease.edges)) {
    return graphEvidenceToken(key, flags, 'ACTIVE_RELEASE_MISSING', 'POSTGRES')
  }
  try {
    const markerRows = await serverModule.neo4jQuery(`
      MATCH (marker:K9Node:K9Release { namespace: $namespace })
      RETURN marker.input_snapshot_hash, marker.policy_hash, marker.node_count, marker.edge_count
    `, { namespace: row.active_release_pointer })
    flags.store = markerRows.length === 1
    if (!flags.store) return graphEvidenceToken(key, flags, 'STORE_RELEASE_MISSING', 'MARKER')
    const marker = markerRows[0]?.row || []
    flags.digest = marker[0] === row.active_input_snapshot_hash
      && marker[1] === row.policy_hash
      && Number(marker[2]) === canonicalRelease.nodes.length
      && Number(marker[3]) === canonicalRelease.edges.length
    if (!flags.digest) return graphEvidenceToken(key, flags, 'ACTIVE_STORE_MISMATCH', 'MARKER')

    const expectedNodes = canonicalRelease.nodes.slice(0, 200)
    const expectedNodeIds = new Set(expectedNodes.map((node) => node.id))
    const expectedEdges = canonicalRelease.edges.filter((edge) => (
      expectedNodeIds.has(edge.source) && expectedNodeIds.has(edge.target)
    ))
    const nodeRows = await serverModule.neo4jQuery(`
      MATCH (node:K9Node)
      WHERE node.namespace = $namespace AND NOT node:K9Release AND node.id IN $nodeIds
      RETURN node.id, node.type, node.classification, node.properties
      ORDER BY node.id
    `, { namespace: row.active_release_pointer, nodeIds: [...expectedNodeIds] })
    const edgeRows = expectedEdges.length ? await serverModule.neo4jQuery(`
      MATCH (source:K9Node { namespace: $namespace })-[relation:K9Edge]->(target:K9Node { namespace: $namespace })
      WHERE source.id IN $nodeIds AND target.id IN $nodeIds
      RETURN source.id, target.id, relation.type, relation.properties
      ORDER BY source.id, target.id, relation.type
    `, { namespace: row.active_release_pointer, nodeIds: [...expectedNodeIds] }) : []
    const observedNodes = nodeRows.map(({ row: values }) => ({
      id: values[0], type: values[1], classification: values[2], properties: graphProperties(values[3]),
    }))
    const observedEdges = edgeRows.map(({ row: values }) => ({
      source: values[0], target: values[1], type: values[2], properties: graphProperties(values[3]),
    }))
    const contentMatches = graphDocumentsEqual(
      expectedNodes, observedNodes, (node) => typeof node?.id === 'string' ? node.id : null,
    ) && graphDocumentsEqual(
      expectedEdges,
      observedEdges,
      (edge) => typeof edge?.source === 'string'
          && typeof edge?.target === 'string'
          && typeof edge?.type === 'string'
        ? canonicalJson([edge.source, edge.target, edge.type])
        : null,
    )
    if (!contentMatches) return graphEvidenceToken(key, flags, 'ACTIVE_STORE_MISMATCH', 'CONTENT')
    const orderMatches = canonicalJson(expectedNodes) === canonicalJson(observedNodes)
      && canonicalJson(expectedEdges) === canonicalJson(observedEdges)
    return orderMatches
      ? graphEvidenceToken(key, flags, 'PASS', 'NONE')
      : graphEvidenceToken(key, flags, 'ACTIVE_STORE_MISMATCH', 'ORDER')
  } catch (error) {
    const cause = boundedToken(error?.neo4jErrorClass, 'OTHER')
    return graphEvidenceToken(key, flags, 'DATABASE_CONNECTION_FAILURE', cause)
  }
}

async function auditManagedGraphs(rows) {
  const tokens = []
  for (const row of rows) tokens.push(await auditManagedGraph(row))
  return tokens.join(';') || 'NONE'
}

function aggregateSubtype(attempts) {
  const failures = attempts.filter((attempt) => attempt.subtype !== 'PASS')
  if (failures.length === 0) return 'PASS_3_OF_3'
  if (failures.length !== attempts.length) return 'INTERMITTENT_CONTRACT_FAILURE'
  return failures.every((failure) => failure.subtype === failures[0].subtype)
    ? failures[0].subtype
    : 'MULTIPLE_CONTRACT_FAILURES'
}

function evidenceLine(attempts, persisted, discoveryBind, graphEvidence) {
  return [
    OUTPUT_PREFIX,
    `subtype=${aggregateSubtype(attempts)}`,
    `ui_requested=${persisted.uiRequestedMode}`,
    `ui_selected=${persisted.uiSelectedMode}`,
    'smoke_requested=AUTO',
    `graph_assets=${persisted.managedGraphRows.length}`,
    `run1=${attemptToken(attempts[0])}`,
    `run2=${attemptToken(attempts[1])}`,
    `run3=${attemptToken(attempts[2])}`,
    `graphs=${graphEvidence}`,
    `constraint=${persisted.constraint}`,
    `discovery_bind=${discoveryBind}`,
  ].join('|')
}

async function main() {
  const persisted = await readPersistedEvidence()
  const [source, stateStoreSource] = await Promise.all([
    readFile(SERVER_PATH, 'utf8'),
    readFile(STATE_STORE_PATH, 'utf8'),
  ])
  const discoveryBind = stateStoreSource.includes(DISCOVERY_SQL_NULL_NEEDLE)
    && stateStoreSource.includes(DISCOVERY_SQL_NEEDLE)
    ? 'SQL_NULL'
    : stateStoreSource.includes(DISCOVERY_JSON_NULL_NEEDLE)
      && stateStoreSource.includes(DISCOVERY_SQL_NEEDLE)
      ? 'JSON_NULL'
      : 'OTHER'
  serverModule = await prepareTemporaryServer(source)
  const stateStore = Object.freeze({
    configured: Object.freeze({ postgres: true }),
    listK9ManagedGraphAssets: async () => persisted.managedGraphRows,
    catalogEmbeddingActiveGeneration: async (bindingHash) => (
      persisted.activeGenerations.get(bindingHash)
    ),
  })
  serverModule.createPocServer({ stateStore })
  const graphEvidence = await auditManagedGraphs(persisted.managedGraphRows)

  globalThis.__DATARIVER_GENERAL_CLASSIFIER_RCA = { providerCalls: 0, requests: [], captureRequest: false }
  const attempts = []
  for (let attempt = 0; attempt < PROBE_ATTEMPT_COUNT; attempt += 1) {
    delete globalThis.__DATARIVER_GENERAL_CLASSIFIER_RCA.classification
    delete globalThis.__DATARIVER_GENERAL_CLASSIFIER_RCA.rawValue
    let route
    let routeError
    try {
      route = await serverModule.chatRoute(
        QUESTION,
        'AUTO',
        Object.freeze({ role: 'admin', subjectId: 'prep-general-rca' }),
        AbortSignal.timeout(130_000),
      )
    } catch (error) {
      routeError = error
    }
    attempts.push(classifierEvidence(route, routeError, {
      classification: globalThis.__DATARIVER_GENERAL_CLASSIFIER_RCA.classification,
      rawValue: globalThis.__DATARIVER_GENERAL_CLASSIFIER_RCA.rawValue,
    }, globalThis.__DATARIVER_GENERAL_CLASSIFIER_RCA.requests[attempt]))
  }
  if (globalThis.__DATARIVER_GENERAL_CLASSIFIER_RCA.providerCalls !== PROBE_ATTEMPT_COUNT) {
    throw probeFailure('PROVIDER_CALL_CONTRACT')
  }
  if (globalThis.__DATARIVER_GENERAL_CLASSIFIER_RCA.requests.length !== PROBE_ATTEMPT_COUNT) {
    throw probeFailure('PROVIDER_REQUEST_CONTRACT')
  }
  process.stdout.write(`${evidenceLine(attempts, persisted, discoveryBind, graphEvidence)}\n`)
}

try {
  await main()
} catch (error) {
  const stage = boundedToken(error?.probeStage, 'RUNTIME')
  process.stdout.write(`${OUTPUT_PREFIX}|subtype=PROBE_FAILED|stage=${stage}\n`)
  process.exitCode = 2
} finally {
  if (transactionStarted && client) await client.query('ROLLBACK').catch(() => undefined)
  client?.release?.()
  await pool?.end?.().catch(() => undefined)
  await serverModule?.providerTransport?.close?.().catch(() => undefined)
  if (temporaryDirectory) await rm(temporaryDirectory, { recursive: true, force: true }).catch(() => undefined)
}
NODE
)"
probe_status=$?
set -e

if [[ -z "$probe_output" || "$probe_output" == *$'\n'* \
  || "$probe_output" != "${OUTPUT_PREFIX}|"* ]]; then
  fail OUTPUT_CONTRACT
fi

printf '%s\n' "$probe_output"
exit "$probe_status"

# END DATARIVER_LEGACY_RCA_PREP39083_GENERAL_CLASSIFIER_V1
