{
  "name": "datariver-next-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "poc": "npm run build:poc && node poc-server.mjs",
    "dev:poc": "vite --config vite.poc.config.ts --mode poc",
    "build": "tsc -b && vite build",
    "build:poc": "tsc -b && vite build --config vite.poc.config.ts --mode poc",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "test:poc": "vitest run --config vitest.config.ts src/poc/PocApp.test.tsx",
    "test:poc-server": "node --test poc-server.test.mjs poc-server.providers.test.mjs chat-router-benchmark.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-table": "8.21.3",
    "@tiptap/extension-table": "^3.30.0",
    "@tiptap/extension-text-align": "^3.30.0",
    "@tiptap/pm": "^3.30.0",
    "@tiptap/react": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "@xyflow/react": "12.11.2",
    "hash-wasm": "4.12.0",
    "lucide-react": "1.21.0",
    "oidc-client-ts": "3.5.0",
    "pg": "^8.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "redis": "^6.2.1",
    "tailwindcss": "4.3.3",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
