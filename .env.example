APP_ENV=development
APP_NAME=DataRiver Next
APP_LOG_LEVEL=INFO
APP_PUBLIC_ORIGIN=http://localhost:8080
APP_CORS_ORIGINS=http://localhost:8080
APP_TRUSTED_HOSTS=localhost,127.0.0.1,api
# This source topology is intentionally not HA. HA acceptance requires external evidence.
DEPLOYMENT_TIER=SINGLE_NODE_PILOT
# DEPLOYMENT_EVIDENCE_REFERENCE=accepted-ha-drill-artifact
API_PORT=8000
POSTGRES_DB=datariver
POSTGRES_USER=datariver_owner

# Required at runtime. Generate locally; never commit real values.
DATABASE_URL=postgresql+asyncpg://datariver_app@postgres:5432/datariver
DATABASE_SECRET_REF=file:/run/secrets/postgres_app_password
MIGRATION_DATABASE_URL=postgresql+asyncpg://datariver_owner@postgres:5432/datariver
MIGRATION_DATABASE_SECRET_REF=file:/run/secrets/postgres_password
RELAY_DATABASE_URL=postgresql+asyncpg://datariver_relay@postgres:5432/datariver
RELAY_DATABASE_SECRET_REF=file:/run/secrets/postgres_relay_password
UPLOAD_DATABASE_URL=postgresql+asyncpg://datariver_upload@postgres:5432/datariver
UPLOAD_DATABASE_SECRET_REF=file:/run/secrets/postgres_upload_password
GOVERNANCE_DATABASE_URL=postgresql+asyncpg://datariver_governance@postgres:5432/datariver
GOVERNANCE_DATABASE_SECRET_REF=file:/run/secrets/postgres_governance_password
EXPORT_DATABASE_URL=postgresql+asyncpg://datariver_export@postgres:5432/datariver
EXPORT_DATABASE_SECRET_REF=file:/run/secrets/postgres_export_password
CATALOG_EXPORT_WORKER_ENABLED=false
BOOTSTRAP_DATABASE_URL=postgresql+asyncpg://datariver_bootstrap@postgres:5432/datariver
BOOTSTRAP_DATABASE_SECRET_REF=file:/run/secrets/postgres_bootstrap_password
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_READINESS_TIMEOUT_SECONDS=1.5
WORKER_DATABASE_POOL_SIZE=5
WORKER_DATABASE_POOL_MAX_OVERFLOW=5
WORKER_DATABASE_POOL_TIMEOUT_SECONDS=10
GOVERNANCE_APPLY_LEASE_SECONDS=120
GOVERNANCE_APPLY_MAXIMUM_ATTEMPTS=8
OUTBOX_MAXIMUM_ATTEMPTS=20
EVENT_RETENTION_DAYS=30
GOVERNANCE_WORKER_SUBJECT_ID=00000000-0000-7000-8000-000000000001
UPLOAD_VALIDATION_LEASE_SECONDS=300
UPLOAD_VALIDATION_MAXIMUM_ATTEMPTS=4
BULK_PREPARATION_LEASE_SECONDS=900
BULK_PREPARATION_MAXIMUM_ATTEMPTS=4
OIDC_ISSUER=http://localhost:8081/realms/datariver
OIDC_AUDIENCE=datariver-api
OIDC_JWKS_URL=http://keycloak:8080/realms/datariver/protocol/openid-connect/certs
OIDC_PUBLIC_AUTHORITY=http://localhost:8081/realms/datariver
OIDC_PUBLIC_ORIGIN=http://localhost:8081
OIDC_CLIENT_ID=datariver-web
OIDC_HARDWARE_ACR_VALUES=2
OIDC_STEP_UP_ACR=2
OIDC_HARDWARE_AMR_VALUES=webauthn,hwk
# Operator-owned platform switches. Disabling WebAuthn does not create a
# password-only bypass: operations that require hardware assurance stay denied.
OIDC_HARDWARE_WEBAUTHN_ENABLED=true
# false keeps one server-assigned default Workspace and hides manual switching;
# workspace ABAC/RLS boundaries remain enabled.
WORKSPACE_SELECTION_ENABLED=true
OIDC_PASSWORD_REAUTH_ACR_VALUES=1
OIDC_PASSWORD_REAUTH_REQUEST_ACR=1
OIDC_PASSWORD_AMR_VALUES=pwd
IDENTITY_ADMIN_ENABLED=false
# Dedicated Keycloak service-account control plane. Never point this at an
# unreviewed IdP or reuse the Keycloak bootstrap/master administrator secret.
# IDENTITY_ADMIN_BASE_URL=http://keycloak:8080
IDENTITY_ADMIN_REALM=datariver
IDENTITY_ADMIN_CLIENT_ID=datariver-identity-admin
# IDENTITY_ADMIN_CLIENT_SECRET_REF=file:/run/secrets/keycloak_identity_admin_client_secret
IDENTITY_ADMIN_TIMEOUT_SECONDS=10
IDENTITY_PASSWORD_CHANGE_ACTION_ENABLED=false
HIGH_RISK_AUTH_MAX_AGE_SECONDS=300
ADMIN_PASSWORD_FALLBACK_ENABLED=false
ADMIN_PASSWORD_FALLBACK_TTL_SECONDS=300
# Development-only native Ollama bridge.  Docker Desktop containers reach a
# Mac-hosted Ollama through this exact gateway; no token is needed or supported.
LOCAL_OLLAMA_CHAT_ENABLED=false
# LOCAL_OLLAMA_CHAT_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_OLLAMA_CHAT_MODEL=datariver-gemma4-dev:0.1
LOCAL_OLLAMA_CHAT_TIMEOUT_SECONDS=60
LOCAL_OLLAMA_CHAT_CONTEXT_TOKENS=8192
LOCAL_OLLAMA_EMBEDDING_ENABLED=false
# LOCAL_OLLAMA_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_OLLAMA_EMBEDDING_MODEL=bge-m3:latest
LOCAL_OLLAMA_EMBEDDING_TIMEOUT_SECONDS=60
# Development-only authenticated bridge to a model server that is strictly
# inside the corporate network. A public/SaaS host is rejected. Endpoints,
# model IDs and API-key references are stored as a tested System Settings
# revision; only this operator-owned hostname allowlist is deployed here.
INTRANET_OPENAI_COMPATIBLE_ALLOWED_HOSTS=
INTRANET_OPENAI_COMPATIBLE_CHAT_ENABLED=false
INTRANET_OPENAI_COMPATIBLE_EMBEDDING_ENABLED=false
# Neo4j remains a rebuildable projection. PostgreSQL releases are canonical.
NEO4J_PROJECTION_ENABLED=false
# NEO4J_URI=bolt://neo4j:7687
NEO4J_DATABASE=neo4j
# NEO4J_AUTH_SECRET_REF=file:/run/secrets/neo4j_auth
NEO4J_CONNECTION_TIMEOUT_SECONDS=30
NEO4J_MAXIMUM_CONNECTION_POOL_SIZE=20
KNOWLEDGE_PIPELINE_ENABLED=false
# Development-only startup resolver. SAVE and TEST do not affect live clients;
# ACTIVATE selects a version and these flags make API/workers load it on restart.
SYSTEM_CONFIGURATION_RUNTIME_ACTIVATION_ENABLED=false
# SYSTEM_CONFIGURATION_RUNTIME_WORKSPACE_ID=00000000-0000-4000-8000-000000000100
# Docker keeps the portable /run/secrets namespace. The source-host launcher
# overrides this with its ignored ./secrets directory.
SYSTEM_CONFIGURATION_SECRET_ROOT=/run/secrets
# This opt-in is required only to test Chat before a local retention policy is
# approved; eligible development administrators receive no persisted exchange.
CHAT_EPHEMERAL_ADMIN_WITHOUT_RETENTION_ENABLED=false

DATAHUB_BASE_URL=https://datahub.example.internal
DATAHUB_SECRET_REF=file:/run/secrets/datahub_token
DATAHUB_EXPECTED_VERSION=v1.6.0
# Optional operational compatibility exception. Each value must be a numbered
# release candidate for DATAHUB_EXPECTED_VERSION (for example v1.6.0rc1), never
# a partial version, a different release line, or a mutable tag.
# DATAHUB_ALLOWED_VERSIONS=v1.6.0rc1
# Use enforce in production. In development, an explicitly allowed compatible RC is accepted by
# the application capability check; report remains useful for other diagnostic mismatches.
DATAHUB_VERSION_ENFORCEMENT=report
DATAHUB_VERSION_PROBE_TTL_SECONDS=300
DATAHUB_TIMEOUT_SECONDS=10
DATAHUB_MAX_CONCURRENCY=20
DATAHUB_QUEUE_TIMEOUT_SECONDS=2
DATAHUB_CIRCUIT_FAILURE_THRESHOLD=5
DATAHUB_CIRCUIT_OPEN_SECONDS=30
DATAHUB_STALE_TTL_SECONDS=900
# Optional browser-visible links. The API publishes only validated URLs without credentials.
# UI_DATAHUB_URL=https://datahub.example.internal
# UI_AIRFLOW_URL=https://airflow.example.internal
# UI_GRAFANA_URL=https://grafana.example.internal
# UI_PROMETHEUS_URL=https://prometheus.example.internal
# UI_GRAPH_URL=https://graph.example.internal
# Neo4j's separate local projection sandbox is exposed only on loopback.
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
# Disabled by default. Enable only after DataHub identity mapping, frame policy and CSP evidence pass.
# DATAHUB_EMBED_BASE_URL=https://datahub.example.internal
# DATAHUB_EMBED_ENABLED=false
# Grafana embedding is independently disabled. Its origin must match UI_GRAFANA_URL,
# and the evidence reference records the deployment's SSO/frame-policy review.
# GRAFANA_EMBED_BASE_URL=https://grafana.example.internal
# GRAFANA_EMBED_ENABLED=false
# GRAFANA_EMBED_EVIDENCE_REFERENCE=SEC-REVIEW-1234

# Redis is operated outside the DataRiver Compose project. Cache and delivery
# must use separate endpoints/databases and independently reviewed policies.
REDIS_CACHE_URL=redis://host.docker.internal:6379/0
REDIS_DELIVERY_URL=redis://host.docker.internal:6380/0
REDIS_CACHE_SECRET_REF=file:/run/secrets/redis_cache_password
REDIS_DELIVERY_SECRET_REF=file:/run/secrets/redis_delivery_password
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_MAX_VALUE_BYTES=1048576
CATALOG_SEARCH_CACHE_TTL_SECONDS=30
CATALOG_SEARCH_MINIMUM_QUERY_LENGTH=2

# MinIO/S3 is operated outside the DataRiver Compose project. The internal
# endpoint is used by API/workers; the public endpoint is signed for browsers.
S3_ENDPOINT_URL=http://host.docker.internal:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ORIGIN=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_QUARANTINE=datariver-quarantine
S3_BUCKET_ACCEPTED=datariver-accepted
S3_BUCKET_EXPORTS=datariver-exports
S3_BUCKET_FILEFOLDER=datariver-filefolder
# Required to enable the manual metadata → Airflow handoff.  This is a
# deployment setting, not a source-code fallback.
S3_BUCKET_INFOSCHEMA=datariver-infoschema
S3_ACCESS_KEY_FILE=/run/secrets/s3_access_key
S3_SECRET_KEY_FILE=/run/secrets/s3_secret_key
S3_EXPORT_ACCESS_KEY_FILE=/run/secrets/s3_export_access_key
S3_EXPORT_SECRET_KEY_FILE=/run/secrets/s3_export_secret_key
PRESIGNED_URL_TTL_SECONDS=900

SEED_PROFILE=none
AIRFLOW_WORKSPACE_ID=
