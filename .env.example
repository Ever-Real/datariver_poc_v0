APP_ENV=development
# Selected by scripts/compose.sh and also used as each backend container's env_file.
DATARIVER_ENV_FILE=.env
# Explicit operator lifecycle. Bootstrap replaces this for a managed profile.
DATARIVER_OPERATOR_PROFILE=unmanaged
DATARIVER_CONNECTOR_NETWORK=datariver-connectors
APP_NAME=DataRiver Next
APP_LOG_LEVEL=INFO
APP_PUBLIC_ORIGIN=http://localhost:8080
APP_CORS_ORIGINS=http://localhost:8080
APP_TRUSTED_HOSTS=localhost,127.0.0.1,api
API_PROXY_READ_TIMEOUT_SECONDS=30
# The local host-development profile intentionally accommodates the governed large-PDF fixture.
HOST_DEV_API_PROXY_READ_TIMEOUT_SECONDS=900
# Explicit Linux/WSL source-host mode. Bootstrap enables this only with
# --host-development --intranet-source-host and two distinct HTTPS origins.
# API, PostgreSQL, Redis and Keycloak upstreams remain loopback-only behind
# the operator-managed reverse proxy.
INTRANET_SOURCE_HOST_ENABLED=false
# Keep false when Airflow is external. The source-host bridge is only for a
# local Docker Airflow that must call a loopback-bound source API.
AIRFLOW_SOURCE_API_BRIDGE_ENABLED=false
# This source topology is intentionally not HA. HA acceptance requires external evidence.
DEPLOYMENT_TIER=SINGLE_NODE_PILOT
# DEPLOYMENT_EVIDENCE_REFERENCE=accepted-ha-drill-artifact
API_PORT=8000
POSTGRES_DB=datariver
POSTGRES_USER=datariver_owner

# Required at runtime. Generate locally; never commit real values.
DATABASE_URL=postgresql+asyncpg://datariver_app@postgres:5432/datariver
DATABASE_SECRET_REF=file:/run/secrets/postgres_app_password
MIGRATION_DATABASE_URL=postgresql+asyncpg://datariver_owner@postgres:5432/datariver
MIGRATION_DATABASE_SECRET_REF=file:/run/secrets/postgres_password
RELAY_DATABASE_URL=postgresql+asyncpg://datariver_relay@postgres:5432/datariver
RELAY_DATABASE_SECRET_REF=file:/run/secrets/postgres_relay_password
UPLOAD_DATABASE_URL=postgresql+asyncpg://datariver_upload@postgres:5432/datariver
UPLOAD_DATABASE_SECRET_REF=file:/run/secrets/postgres_upload_password
GOVERNANCE_DATABASE_URL=postgresql+asyncpg://datariver_governance@postgres:5432/datariver
GOVERNANCE_DATABASE_SECRET_REF=file:/run/secrets/postgres_governance_password
# One-target DataHub Profile collection is disabled until a dedicated Subject, V4 retention
# policy, least-privilege DataHub token and provenance key are provisioned.
CATALOG_PROFILE_COLLECTOR_ENABLED=false
# CATALOG_PROFILE_DATABASE_URL=postgresql+asyncpg://datariver_catalog_profile@postgres:5432/datariver
# CATALOG_PROFILE_DATABASE_SECRET_REF=file:/run/secrets/postgres_catalog_profile_password
# CATALOG_PROFILE_DATAHUB_SECRET_REF=file:/run/secrets/datahub_profile_token
# CATALOG_PROFILE_SUBJECT_ID=<pre-provisioned-service-subject-uuid>
# CATALOG_PROFILE_FRESHNESS_SLA_SECONDS=<approved-positive-seconds>
# CATALOG_PROFILE_PROVIDER_CONFIG_HASH=<64-lowercase-hex-recipe-hash>
# CATALOG_PROFILE_PROVENANCE_KEY_ID=<approved-key-id>
# CATALOG_PROFILE_PROVENANCE_KEY_SECRET_REF=file:/run/secrets/catalog_profile_provenance_key
# GX execution stays disabled until an operator provisions the exact manifest, source
# read-only secrets, worker Subject/Workspace and approved scan budgets.
QUALITY_WORKER_ENABLED=false
# QUALITY_DATABASE_URL=postgresql+asyncpg://datariver_quality@postgres:5432/datariver
# QUALITY_DATABASE_SECRET_REF=file:/run/secrets/postgres_quality_password
# QUALITY_WORKER_SUBJECT_ID=<pre-provisioned-quality-worker-subject-uuid>
# QUALITY_WORKER_WORKSPACE_ID=<approved-workspace-uuid>
# QUALITY_SOURCE_MANIFEST_FILE=/run/datariver/quality/source-manifest.json
QUALITY_SOURCE_SECRET_ROOT=/run/secrets/quality-sources
# QUALITY_WORKER_FINGERPRINT=<deployment-owned-stable-worker-id>
QUALITY_WORKER_LEASE_SECONDS=360
# QUALITY_DISPATCH_MAX_DUE_SCHEDULES=<deployment-approved-limit-1-to-100>
# QUALITY_DISPATCH_MAX_CREATED_RUNS=<deployment-approved-limit-1-to-100>
GOVERNANCE_DOCUMENT_WORKER_ENABLED=false
# GOVERNANCE_DOCUMENT_DATABASE_URL=postgresql+asyncpg://datariver_governance_document@postgres:5432/datariver
# GOVERNANCE_DOCUMENT_DATABASE_SECRET_REF=file:/run/secrets/postgres_governance_document_password
GOVERNANCE_DOCUMENT_WORKER_POLL_SECONDS=2
GOVERNANCE_DOCUMENT_WORKER_LEASE_SECONDS=300
KNOWLEDGE_DATABASE_URL=postgresql+asyncpg://datariver_knowledge@postgres:5432/datariver
KNOWLEDGE_DATABASE_SECRET_REF=file:/run/secrets/postgres_knowledge_password
EXPORT_DATABASE_URL=postgresql+asyncpg://datariver_export@postgres:5432/datariver
EXPORT_DATABASE_SECRET_REF=file:/run/secrets/postgres_export_password
CATALOG_EXPORT_WORKER_ENABLED=false
RETENTION_SCHEDULER_DATABASE_URL=postgresql+asyncpg://datariver_retention_scheduler@postgres:5432/datariver
RETENTION_SCHEDULER_DATABASE_SECRET_REF=file:/run/secrets/postgres_retention_scheduler_password
ARCHIVE_DATABASE_URL=postgresql+asyncpg://datariver_archive@postgres:5432/datariver
ARCHIVE_DATABASE_SECRET_REF=file:/run/secrets/postgres_archive_password
# Archive-only Phase 2 is opt-in and still never enables deletion or partition drop.
RETENTION_ARCHIVE_EXECUTION_ENABLED=false
# Live fail-closed gate: exact file content ENABLED permits work; every other state denies it.
RETENTION_EXECUTION_CONTROL_FILE=/run/datariver/retention-execution.enabled
# Comma-separated UUID allowlist; required and non-empty only when the archive profile is enabled.
RETENTION_WORKSPACE_IDS=
RETENTION_CLAIM_BATCH_SIZE=10
RETENTION_LEASE_SECONDS=300
RETENTION_MAXIMUM_ATTEMPTS=4
RETENTION_WORKER_DATABASE_POOL_SIZE=1
RETENTION_WORKER_DATABASE_POOL_MAX_OVERFLOW=0
# Container-internal Prometheus endpoint; it is never published on the host by default.
RETENTION_METRICS_PORT=9102
BOOTSTRAP_DATABASE_URL=postgresql+asyncpg://datariver_bootstrap@postgres:5432/datariver
BOOTSTRAP_DATABASE_SECRET_REF=file:/run/secrets/postgres_bootstrap_password
DATABASE_POOL_SIZE=10
DATABASE_POOL_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_READINESS_TIMEOUT_SECONDS=1.5
WORKER_DATABASE_POOL_SIZE=5
WORKER_DATABASE_POOL_MAX_OVERFLOW=5
WORKER_DATABASE_POOL_TIMEOUT_SECONDS=10
WORKER_POLL_SECONDS=0.5
GOVERNANCE_APPLY_LEASE_SECONDS=120
GOVERNANCE_APPLY_MAXIMUM_ATTEMPTS=8
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAXIMUM_ATTEMPTS=20
EVENT_RETENTION_DAYS=30
GOVERNANCE_WORKER_SUBJECT_ID=00000000-0000-4000-8000-000000000102
EXPORT_WORKER_SUBJECT_ID=00000000-0000-7000-8000-000000000002
RETENTION_WORKER_SUBJECT_ID=00000000-0000-7000-8000-000000000003
KNOWLEDGE_WORKER_SUBJECT_ID=00000000-0000-7000-8000-000000000004
UPLOAD_LEASE_SECONDS=120
UPLOAD_MAXIMUM_ATTEMPTS=8
UPLOAD_VALIDATION_LEASE_SECONDS=300
UPLOAD_VALIDATION_MAXIMUM_ATTEMPTS=4
BULK_PREPARATION_LEASE_SECONDS=900
BULK_PREPARATION_MAXIMUM_ATTEMPTS=4
CATALOG_EXPORT_ACCESS_TTL_SECONDS=86400
CATALOG_EXPORT_DOWNLOAD_TTL_SECONDS=60
CATALOG_EXPORT_LEASE_SECONDS=900
CATALOG_EXPORT_MAXIMUM_ATTEMPTS=4
CATALOG_EXPORT_PAGE_SIZE=1000
CATALOG_EXPORT_MAXIMUM_ROWS=1000000
CATALOG_EXPORT_MAXIMUM_BYTES=1073741824
OIDC_ISSUER=http://localhost:8081/realms/datariver
OIDC_AUDIENCE=datariver-api
OIDC_JWKS_URL=http://keycloak:8080/realms/datariver/protocol/openid-connect/certs
OIDC_ALLOWED_ALGORITHMS=RS256,ES256
OIDC_PUBLIC_AUTHORITY=http://localhost:8081/realms/datariver
OIDC_PUBLIC_ORIGIN=http://localhost:8081
OIDC_CLIENT_ID=datariver-web
OIDC_HARDWARE_ACR_VALUES=2
OIDC_STEP_UP_ACR=2
OIDC_HARDWARE_AMR_VALUES=webauthn,hwk
# Operator-owned platform switches. WebAuthn is opt-in so an intranet test
# environment does not expose unusable device enrollment controls by default.
# Enabling it requires an IdP WebAuthn flow. Disabling it never creates a
# password-only bypass: operations that require hardware assurance stay denied.
OIDC_HARDWARE_WEBAUTHN_ENABLED=false
# false keeps one server-assigned default Workspace and hides manual switching;
# workspace ABAC/RLS boundaries remain enabled.
WORKSPACE_SELECTION_ENABLED=false
OIDC_PASSWORD_REAUTH_ACR_VALUES=1
OIDC_PASSWORD_REAUTH_REQUEST_ACR=1
OIDC_PASSWORD_AMR_VALUES=pwd
IDENTITY_ADMIN_ENABLED=false
# Dedicated Keycloak service-account control plane. Never point this at an
# unreviewed IdP or reuse the Keycloak bootstrap/master administrator secret.
# IDENTITY_ADMIN_BASE_URL=http://keycloak:8080
IDENTITY_ADMIN_REALM=datariver
IDENTITY_ADMIN_CLIENT_ID=datariver-identity-admin
# IDENTITY_ADMIN_CLIENT_SECRET_REF=file:/run/secrets/keycloak_identity_admin_client_secret
IDENTITY_ADMIN_TIMEOUT_SECONDS=10
IDENTITY_PASSWORD_CHANGE_ACTION_ENABLED=false
HIGH_RISK_AUTH_MAX_AGE_SECONDS=300
ADMIN_PASSWORD_FALLBACK_ENABLED=false
ADMIN_PASSWORD_FALLBACK_TTL_SECONDS=300
# Development-only, fail-closed administrator password exception. ADR-0087
# additionally scopes it to Governance Document publish/archive operations.
# Requires APP_ENV=development, ADMIN_PASSWORD_FALLBACK_ENABLED=true and
# OIDC_HARDWARE_WEBAUTHN_ENABLED=false. Never enable in production.
DEVELOPMENT_ADMIN_PASSWORD_BYPASS_ENABLED=false
# Development-only native Ollama bridge.  Docker Desktop containers reach a
# Mac-hosted Ollama through this exact gateway; no token is needed or supported.
LOCAL_INFERENCE_SOURCE_HOST_ENABLED=false
# Exact comma-separated hosts reachable from the selected API runtime. WSL or
# another development host changes this value and the three base URLs only;
# source code and browser configuration remain unchanged.
LOCAL_INFERENCE_ALLOWED_HOSTS=host.docker.internal
LOCAL_OLLAMA_CHAT_ENABLED=false
# The configured inventory endpoint remains /v1 for shared discovery/display,
# while the Chat runtime derives the same origin's native /api/chat route so
# options.num_ctx is enforced by Ollama.
# LOCAL_OLLAMA_CHAT_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_OLLAMA_CHAT_MODEL=<installed-model-id>
LOCAL_OLLAMA_CHAT_TIMEOUT_SECONDS=60
LOCAL_OLLAMA_CHAT_CONTEXT_TOKENS=8192
LOCAL_OLLAMA_EMBEDDING_ENABLED=false
# LOCAL_OLLAMA_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_OLLAMA_EMBEDDING_MODEL=<installed-model-id>
LOCAL_OLLAMA_EMBEDDING_TIMEOUT_SECONDS=60
# Ollama owns the GGUF model. A local llama-server process exposes the fixed
# /v1/rerank contract because Ollama does not provide that route.
LOCAL_LLAMA_CPP_RERANKER_ENABLED=false
# LOCAL_LLAMA_CPP_RERANKER_BASE_URL=http://host.docker.internal:11435/v1
# LOCAL_LLAMA_CPP_RERANKER_MODEL=<installed-model-id>
LOCAL_LLAMA_CPP_RERANKER_TIMEOUT_SECONDS=60
LOCAL_LLAMA_CPP_RERANKER_TOP_N=10
# Development-only authenticated bridge to a model server that is strictly
# inside the corporate network. A public/SaaS host is rejected. Endpoints,
# model IDs, API-key references and the hostname allowlist are deployment-owned
# environment values; Admin can display their redacted state and test only.
INTRANET_OPENAI_COMPATIBLE_ALLOWED_HOSTS=
# Optional comma-separated subset of the host allowlist. Keep empty for the
# private-address-only default. Add only company-approved enterprise gateway
# hostnames that intentionally resolve to global/public IP addresses.
INTRANET_OPENAI_COMPATIBLE_APPROVED_PUBLIC_HOSTS=
INTRANET_OPENAI_COMPATIBLE_CHAT_ENABLED=false
# INTRANET_OPENAI_COMPATIBLE_CHAT_BASE_URL=https://llm.internal.example/v1
# INTRANET_OPENAI_COMPATIBLE_CHAT_MODEL=<approved-model-id>
# INTRANET_OPENAI_COMPATIBLE_CHAT_API_KEY_SECRET_REF=file:/run/secrets/intranet_llm_chat_api_key
INTRANET_OPENAI_COMPATIBLE_CHAT_TIMEOUT_SECONDS=60
INTRANET_OPENAI_COMPATIBLE_CHAT_CONTEXT_TOKENS=8192
# Deployment-owned, bounded generation compatibility options. DataRiver always
# sends stream=false because its governed response validators are non-streaming.
INTRANET_OPENAI_COMPATIBLE_CHAT_TEMPERATURE=0
# INTRANET_OPENAI_COMPATIBLE_CHAT_TOP_P=0.9
# INTRANET_OPENAI_COMPATIBLE_CHAT_REPETITION_PENALTY=1.05
INTRANET_OPENAI_COMPATIBLE_CHAT_ENABLE_THINKING=false
INTRANET_OPENAI_COMPATIBLE_EMBEDDING_ENABLED=false
# INTRANET_OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=https://llm.internal.example/v1
# INTRANET_OPENAI_COMPATIBLE_EMBEDDING_MODEL=<approved-model-id>
# INTRANET_OPENAI_COMPATIBLE_EMBEDDING_API_KEY_SECRET_REF=file:/run/secrets/intranet_llm_embedding_api_key
INTRANET_OPENAI_COMPATIBLE_EMBEDDING_TIMEOUT_SECONDS=60
# Reranking is a separate fixed private POST <base-url>/rerank contract, not
# part of the OpenAI-compatible API. The base URL may include a gateway prefix.
INTRANET_RERANKER_ENABLED=false
# INTRANET_RERANKER_BASE_URL=https://llm.internal.example/api/llm/openai
# INTRANET_RERANKER_MODEL=/models/Reranker/bge-reranker-v2-m3
# INTRANET_RERANKER_API_KEY_SECRET_REF=file:/run/secrets/intranet_llm_reranker_api_key
INTRANET_RERANKER_TIMEOUT_SECONDS=60
INTRANET_RERANKER_TOP_N=10
# One provider token may be copied into all three mounted secret files. The
# separate file targets preserve stage-specific rotation and audit boundaries.
# Neo4j remains a rebuildable projection. PostgreSQL releases are canonical.
# Set this tag only after loading the separately checksummed offline image.
# Connected environments normally retain compose.local-connectors.yaml's
# digest-pinned default instead.
# NEO4J_IMAGE=neo4j:2026.06.0
NEO4J_PROJECTION_ENABLED=false
# Set only by the source-host launcher/profile derivation. Containerized
# application services keep this false.
NEO4J_SOURCE_HOST_ENABLED=false
# Containerized API:
# NEO4J_URI=bolt://neo4j:7687
# WSL source-host API with the local connector's published Bolt port:
# NEO4J_URI=bolt://127.0.0.1:17687
# Use NEO4J_ALLOWED_HOSTS=127.0.0.1 with the WSL source-host URI.
NEO4J_ALLOWED_HOSTS=neo4j
NEO4J_DATABASE=neo4j
# NEO4J_AUTH_SECRET_REF=file:/run/secrets/neo4j_auth
NEO4J_CONNECTION_TIMEOUT_SECONDS=30
NEO4J_MAXIMUM_CONNECTION_POOL_SIZE=20
KNOWLEDGE_PIPELINE_ENABLED=false
# Durable PDF analysis is a separate bounded worker. Enabling it requires the
# dedicated DB and read-only S3 credentials above plus activated Chat/Embedding contracts.
# Neo4j is required only for independently activated release projection/query capabilities.
KNOWLEDGE_SOURCE_WORKER_ENABLED=false
KNOWLEDGE_SOURCE_JOB_MAXIMUM_ATTEMPTS=3
KNOWLEDGE_SOURCE_WORKER_LEASE_SECONDS=300
KNOWLEDGE_SOURCE_WORKER_POLL_SECONDS=2
KNOWLEDGE_SOURCE_MEMORY_SPOOL_BYTES=1048576
KNOWLEDGE_SOURCE_SPOOL_DIRECTORY=/var/spool/datariver-knowledge
# Durable Studio document-to-T-Box inference is a separately isolated worker.
# It reuses only the no-list/no-write Knowledge object credential and requires
# its own PostgreSQL login and secret.
KNOWLEDGE_STUDIO_PROPOSAL_WORKER_ENABLED=false
# KNOWLEDGE_PROPOSAL_DATABASE_URL=postgresql+asyncpg://datariver_knowledge_proposal@postgres:5432/datariver
# KNOWLEDGE_PROPOSAL_DATABASE_SECRET_REF=file:/run/secrets/postgres_knowledge_proposal_password
# KNOWLEDGE_STUDIO_PROPOSAL_WORKER_SUBJECT_ID=<service-subject-uuid>
# KNOWLEDGE_STUDIO_PROPOSAL_WORKSPACE_ID=<workspace-uuid>
# KNOWLEDGE_STUDIO_PROPOSAL_WORKER_FINGERPRINT=<deployment-worker-identity>
KNOWLEDGE_STUDIO_PROPOSAL_WORKER_POLL_SECONDS=2
KNOWLEDGE_STUDIO_PROPOSAL_WORKER_LEASE_SECONDS=300
KNOWLEDGE_STUDIO_PROPOSAL_JOB_MAXIMUM_ATTEMPTS=3
KNOWLEDGE_STUDIO_PROPOSAL_MEMORY_SPOOL_BYTES=1048576
KNOWLEDGE_STUDIO_PROPOSAL_SPOOL_DIRECTORY=/var/spool/datariver-knowledge-proposal
# Actual Studio DB ingestion is disabled until a dedicated DB role/service
# Subject, exact source manifest and approved retention binding are provisioned.
KNOWLEDGE_STUDIO_INGESTION_WORKER_ENABLED=false
# KNOWLEDGE_INGESTION_DATABASE_URL=postgresql+asyncpg://datariver_knowledge_ingestion@postgres:5432/datariver
# KNOWLEDGE_INGESTION_DATABASE_SECRET_REF=file:/run/secrets/postgres_knowledge_ingestion_password
# KNOWLEDGE_STUDIO_INGESTION_WORKER_SUBJECT_ID=<service-subject-uuid>
# KNOWLEDGE_STUDIO_INGESTION_WORKSPACE_ID=<workspace-uuid>
# KNOWLEDGE_STUDIO_INGESTION_WORKER_FINGERPRINT=<deployment-worker-identity>
# KNOWLEDGE_STUDIO_SOURCE_MANIFEST_FILE=/run/datariver/knowledge-studio/postgres-sources.json
KNOWLEDGE_STUDIO_SOURCE_SECRET_ROOT=/run/secrets/knowledge-studio-sources
# KNOWLEDGE_STUDIO_INGESTION_RETENTION_BINDING_REFERENCE=<approved-control-reference>
KNOWLEDGE_STUDIO_INGESTION_WORKER_POLL_SECONDS=2
KNOWLEDGE_STUDIO_INGESTION_WORKER_LEASE_SECONDS=300
KNOWLEDGE_STUDIO_INGESTION_SOURCE_HARD_TIMEOUT_SECONDS=180
KNOWLEDGE_STUDIO_INGESTION_COMPLETION_MARGIN_SECONDS=30

# ==============================================================================
# K9 Managed Studio Publisher (Intranet Distinct-Principal Policy)
# ==============================================================================
KNOWLEDGE_STUDIO_INTRANET_PUBLICATION_ASSURANCE_MODE=HARDWARE_WEBAUTHN
# KNOWLEDGE_STUDIO_INTRANET_PUBLISHER_MAKER_SUBJECT_ID=<service-subject-uuid>
# KNOWLEDGE_STUDIO_INTRANET_PUBLISHER_CHECKER_SUBJECT_ID=<service-subject-uuid>
# Docker keeps the portable /run/secrets namespace. The source-host launcher
# overrides this with its ignored ./secrets directory.
SYSTEM_CONFIGURATION_SECRET_ROOT=/run/secrets
# Retired compatibility switch. Bootstrap always normalizes legacy profiles to
# false; deployment environment + restart is the only activation mechanism.
SYSTEM_CONFIGURATION_RUNTIME_ACTIVATION_ENABLED=false
# Comma-separated exact hostnames/IPs used by fixed Admin connection probes.
# Add deployment-specific connector and OIDC JWKS hosts; no wildcard is accepted.
# SYSTEM_CONFIGURATION_PROBE_ALLOWED_HOSTS=<comma-separated-reviewed-hosts>
# Optional isolated-network exception for fixed Admin probes over HTTP/redis/bolt.
# Values must be exact IP literals already present above; URLs, ports, DNS names,
# CIDRs and wildcards are rejected. This does not relax HTTPS-only inference.
# SYSTEM_CONFIGURATION_PROBE_PLAINTEXT_ALLOWED_IPS=<comma-separated-reviewed-ips>
# This opt-in is required only to test Chat before a local retention policy is
# approved; eligible development administrators receive no persisted exchange.
CHAT_EPHEMERAL_ADMIN_WITHOUT_RETENTION_ENABLED=false
CHAT_RATE_LIMIT_REQUESTS_PER_MINUTE=30
CHAT_RATE_LIMIT_TOKENS_PER_MINUTE=1000000
CHAT_CONVERSATION_MEMORY_ENABLED=true
# Completed user turns before request-time compression begins. From the next
# request onward it runs again on every request; this is not a saved checkpoint.
CHAT_CONVERSATION_COMPRESSION_START_AFTER_USER_TURNS=3
# Conservative per-request memory allowance. The API subtracts fixed
# system/output reserves from the selected provider-specific context window.
CHAT_CONVERSATION_CONTEXT_MAX_TOKENS=2048
# Stage-specific governance bindings. These remain unset until an active
# classification policy references the exact approved profile for each enabled
# interactive inference stage.
# CHAT_COMPOSITION_PROVIDER_PROFILE_VERSION_ID=<approved-chat-profile-version-uuid>
# CHAT_EMBEDDING_PROVIDER_PROFILE_VERSION_ID=<approved-embedding-profile-version-uuid>
# CHAT_RERANKER_PROVIDER_PROFILE_VERSION_ID=<approved-reranker-profile-version-uuid>

DATAHUB_BASE_URL=https://datahub.example.internal
DATAHUB_SECRET_REF=file:/run/secrets/datahub_token
DATAHUB_EXPECTED_VERSION=v1.6.0
# Optional operational compatibility exception. Each value must be a numbered
# release candidate for DATAHUB_EXPECTED_VERSION (for example v1.6.0rc1), never
# a partial version, a different release line, or a mutable tag.
# DATAHUB_ALLOWED_VERSIONS=v1.6.0rc1
# Use enforce in production. In development, an explicitly allowed compatible RC is accepted by
# the application capability check; report remains useful for other diagnostic mismatches.
DATAHUB_VERSION_ENFORCEMENT=report
DATAHUB_VERSION_PROBE_TTL_SECONDS=300
DATAHUB_TIMEOUT_SECONDS=10
DATAHUB_MAX_CONCURRENCY=20
DATAHUB_QUEUE_TIMEOUT_SECONDS=2
DATAHUB_CIRCUIT_FAILURE_THRESHOLD=5
DATAHUB_CIRCUIT_OPEN_SECONDS=30
DATAHUB_STALE_TTL_SECONDS=900
# Full-reconciliation deletion stays disabled unless the external DataHub owner
# proves PIT-backed scroll on this exact deployment and records the evidence.
DATAHUB_CATALOG_PIT_VERIFIED=false
# DATAHUB_CATALOG_PIT_EVIDENCE_REFERENCE=ops://datahub/pit/accepted-run-id
# 100 rows/page: 10,002 permits one million assets plus the empty terminal probe.
DATARIVER_CATALOG_SYNC_MAX_PAGES=10002
# Optional browser-visible links. The API publishes only validated URLs without credentials.
# UI_DATAHUB_URL=https://datahub.example.internal
# UI_AIRFLOW_URL=https://airflow.example.internal
# UI_GRAFANA_URL=https://grafana.example.internal
# UI_PROMETHEUS_URL=https://prometheus.example.internal
# UI_GRAPH_URL=https://graph.example.internal
# Neo4j's separate local projection sandbox is exposed only on loopback.
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
# Disabled by default. Enable only after DataHub identity mapping, frame policy and CSP evidence pass.
# DATAHUB_EMBED_BASE_URL=https://datahub.example.internal
# DATAHUB_EMBED_ENABLED=false
# Grafana embedding is independently disabled. Its origin must match UI_GRAFANA_URL,
# and the evidence reference records the deployment's SSO/frame-policy review.
# GRAFANA_EMBED_BASE_URL=https://grafana.example.internal
# GRAFANA_EMBED_ENABLED=false
# GRAFANA_EMBED_EVIDENCE_REFERENCE=SEC-REVIEW-1234

# Redis is operated outside the DataRiver Compose project. Cache and delivery
# must use separate endpoints/databases and independently reviewed policies.
REDIS_CACHE_URL=redis://host.docker.internal:6379/0
REDIS_DELIVERY_URL=redis://host.docker.internal:6380/0
REDIS_CACHE_SECRET_REF=file:/run/secrets/redis_cache_password
REDIS_DELIVERY_SECRET_REF=file:/run/secrets/redis_delivery_password
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_MAX_VALUE_BYTES=1048576
CATALOG_SEARCH_CACHE_TTL_SECONDS=30
CATALOG_SEARCH_MINIMUM_QUERY_LENGTH=2

# MinIO/S3 is operated outside the DataRiver Compose project. The internal
# endpoint is used by API/workers; the public endpoint is signed for browsers.
S3_ENDPOINT_URL=http://host.docker.internal:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ORIGIN=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_QUARANTINE=datariver-quarantine
S3_BUCKET_ACCEPTED=datariver-accepted
S3_BUCKET_EXPORTS=datariver-exports
S3_BUCKET_FILEFOLDER=datariver-filefolder
# Required to enable the manual metadata → Airflow handoff.  This is a
# deployment setting, not a source-code fallback.
S3_BUCKET_INFOSCHEMA=datariver-infoschema
S3_CORS_MANAGEMENT_MODE=bucket
S3_ACCESS_KEY_FILE=/run/secrets/s3_access_key
S3_SECRET_KEY_FILE=/run/secrets/s3_secret_key
S3_EXPORT_ACCESS_KEY_FILE=/run/secrets/s3_export_access_key
S3_EXPORT_SECRET_KEY_FILE=/run/secrets/s3_export_secret_key
S3_KNOWLEDGE_ACCESS_KEY_FILE=/run/secrets/s3_knowledge_access_key
S3_KNOWLEDGE_SECRET_KEY_FILE=/run/secrets/s3_knowledge_secret_key
S3_GOVERNANCE_DOCUMENT_ACCESS_KEY_FILE=/run/secrets/s3_governance_document_access_key
S3_GOVERNANCE_DOCUMENT_SECRET_KEY_FILE=/run/secrets/s3_governance_document_secret_key
# Dedicated immutable archive settings have no source default. Configure an Object-Lock target
# accepted under ADR-0010/0012 before enabling the retention-archive profile.
# S3_ARCHIVE_ENDPOINT_URL=https://archive.internal.example
# S3_ARCHIVE_REGION=us-east-1
# S3_ARCHIVE_BUCKET=datariver-immutable-evidence
# S3_ARCHIVE_PREFIX=retention-evidence
S3_ARCHIVE_ACCESS_KEY_FILE=/run/secrets/s3_archive_access_key
S3_ARCHIVE_SECRET_KEY_FILE=/run/secrets/s3_archive_secret_key
# SHA-256 of the reviewed server-side encryption/key-management profile.
# S3_ARCHIVE_ENCRYPTION_PROFILE_FINGERPRINT=<64 lowercase hex characters>
# SHA-256 fingerprint of the dedicated runtime archive principal.
# S3_ARCHIVE_WORKER_PRINCIPAL_FINGERPRINT=<64 lowercase hex characters>
PRESIGNED_URL_TTL_SECONDS=900

SEED_PROFILE=none
AIRFLOW_WORKSPACE_ID=
